@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Xác thực OTP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); height: 100vh; display: flex; align-items: center; justify-content: center; }
        .otp-card { background: white; padding: 30px; border-radius: 15px; box-shadow: 0 10px 20px rgba(0,0,0,0.2); width: 350px; text-align: center; }
        .otp-input { font-size: 24px; font-weight: bold; text-align: center; letter-spacing: 5px; border: 2px solid #dee2e6; margin-bottom: 20px; }
    </style>
</head>
<body>
    <div class="otp-card">
        <h4 class="mb-3" style="color: #1e3a8a;">Xác nhận OTP</h4>
        <p class="text-muted small">Nhập mã 6 số từ cửa sổ Output Debug</p>

        @if (ViewBag.Error != null)
        {
            <div class="text-danger mb-2 small">@ViewBag.Error</div>
        }

        <form asp-action="VerifyOTP" method="post">
            <input type="text" name="otpInput" class="form-control otp-input" maxlength="6" required placeholder="000000">
            <button type="submit" class="btn btn-primary w-100 p-2 fw-bold" style="background: #1e3a8a;">Xác thực</button>
        </form>
    </div>
</body>
</html>