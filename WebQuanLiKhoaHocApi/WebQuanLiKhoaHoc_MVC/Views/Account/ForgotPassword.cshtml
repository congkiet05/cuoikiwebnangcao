@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - Hệ thống đào tạo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: #ffffff;
            padding: 2.5rem;
            border-radius: 1rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 400px;
        }

        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }

            .login-header h2 {
                color: #1e3a8a;
                font-weight: 700;
                font-size: 1.5rem;
            }

        .btn-primary {
            background-color: #1e3a8a;
            border: none;
            padding: 0.75rem;
            font-weight: 600;
            width: 100%;
        }

            .btn-primary:hover {
                background-color: #1e40af;
            }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <h2>Quên mật khẩu</h2>
            <p class="text-muted">Nhập Email để nhận mã OTP xác thực</p>
            
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center" style="font-size: 0.85rem;">@ViewBag.Error</div>
        }

        <form asp-action="ForgotPassword" asp-controller="Account" method="post">
            <div class="mb-4">
                <label class="form-label fw-bold" style="color: #374151;">Email của bạn</label>
                <input type="email" name="email" class="form-control p-3" placeholder="example@ute.edu.vn" required>
            </div>

            <button type="submit" class="btn btn-primary mb-3">Gửi mã xác nhận</button>

            <div class="text-center">
                <a href="@Url.Action("Login", "Account")" class="text-decoration-none small" style="color: #3b82f6;">Quay lại Đăng nhập</a>
            </div>
        </form>
    </div>
</body>
</html>