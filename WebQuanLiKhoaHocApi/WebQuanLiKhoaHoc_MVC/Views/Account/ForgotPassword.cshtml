@model WebQuanLiKhoaHoc_MVC.Models.Login.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Khôi Phục Tài Khoản";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            /* Giữ nguyên background giống trang Login của bạn */
            background: radial-gradient(circle at 20% 20%, #5f9cff, transparent 40%), radial-gradient(circle at 80% 80%, #8fd3f4, transparent 40%), linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        .auth-card {
            width: 100%;
            max-width: 450px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            text-align: center;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .icon-header {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px auto;
            color: #fff;
            font-size: 40px;
            box-shadow: 0 10px 20px rgba(142, 197, 252, 0.3);
        }

        h3 {
            font-weight: 700;
            color: #333;
            margin-bottom: 10px;
        }

        p.text-muted {
            font-size: 14px;
            margin-bottom: 30px;
        }

        .form-control {
            height: 50px;
            border-radius: 12px;
            border: 2px solid #eee;
            padding-left: 20px;
            transition: all 0.3s;
            background-color: #f8f9fa;
        }

            .form-control:focus {
                border-color: #8ec5fc;
                box-shadow: 0 0 0 4px rgba(142, 197, 252, 0.2);
                background-color: #fff;
            }

        .btn-submit {
            height: 50px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0d6efd, #4f8cff);
            border: none;
            font-weight: 600;
            letter-spacing: 0.5px;
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
            transition: transform 0.2s;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                background: linear-gradient(135deg, #0b5ed7, #3d7bf5);
            }

        .back-link {
            display: inline-block;
            margin-top: 25px;
            color: #6c757d;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s;
        }

            .back-link:hover {
                color: #0d6efd;
            }
    </style>
</head>
<body>

    <div class="auth-card">
        <div class="icon-header">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h3>Quên Mật Khẩu?</h3>
        <p class="text-muted">Đừng lo lắng! Hãy nhập email đăng ký của bạn, chúng tôi sẽ giúp bạn lấy lại mật khẩu.</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-4 text-start">
                <label class="form-label fw-bold text-secondary ms-1">Email</label>
                <div class="input-group">
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block ms-1"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-submit">
                Gửi Yêu Cầu <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </form>

        <a asp-action="Login" asp-controller="Login" class="back-link">
            <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
        </a>
    </div>

</body>
</html>