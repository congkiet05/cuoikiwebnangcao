@{
    Layout = null;
    ViewData["Title"] = "Đăng Nhập Hệ Thống";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: radial-gradient(circle at 20% 20%, #5f9cff, transparent 40%), radial-gradient(circle at 80% 80%, #8fd3f4, transparent 40%), linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Segoe UI", system-ui, sans-serif;
            padding: 24px;
        }

        .login-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 900px;
            max-width: 95%;
            border-radius: 20px;
            overflow: hidden;
            backdrop-filter: blur(18px);
            background: rgba(255, 255, 255, 0.15);
            box-shadow: 0 30px 60px rgba(0,0,0,0.3);
        }

        /* LEFT */
        .login-info {
            padding: 60px 50px;
            color: #ffffff;
            background: linear-gradient(135deg, rgba(13,110,253,0.9), rgba(79,140,255,0.9));
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-info h1 {
                font-weight: 800;
                margin-bottom: 15px;
                letter-spacing: 1px;
            }

            .login-info p {
                font-size: 15px;
                opacity: 0.9;
                line-height: 1.6;
                margin: 0;
            }

            .login-info .tag {
                margin-top: 25px;
                font-size: 13px;
                opacity: 0.85;
            }

        /* RIGHT */
        .login-form {
            padding: 60px 50px;
            background: rgba(255,255,255,0.85);
        }

            .login-form h3 {
                font-weight: 700;
                margin-bottom: 8px;
            }

            .login-form span {
                font-size: 14px;
                color: #6c757d;
            }

        .form-label {
            margin-top: 20px;
            font-size: 14px;
            font-weight: 600;
        }

        .form-control {
            height: 46px;
            border-radius: 12px;
            border: 1px solid #ced4da;
            padding-left: 14px;
            background-color: #f8f9fa;
        }

            .form-control:focus {
                background-color: #fff;
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.15rem rgba(13,110,253,.25);
            }

        .btn-login {
            margin-top: 30px;
            height: 48px;
            border-radius: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            background: linear-gradient(135deg, #0d6efd, #4f8cff);
            border: none;
            transition: all 0.3s ease;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(13,110,253,0.45);
            }

        .alert {
            margin-top: 15px;
            border-radius: 12px;
            font-size: 14px;
        }

        .footer {
            margin-top: 40px;
            font-size: 12px;
            color: #6c757d;
            text-align: center;
        }

        /* Razor cshtml: phải viết @@media */
        @@media (max-width: 768px) {
            .login-wrapper {
                grid-template-columns: 1fr;
            }

            .login-info {
                display: none;
            }

            .login-form {
                padding: 40px 24px;
            }
        }
    </style>

</head>

<body>

    <div class="login-wrapper">

        <!-- LEFT INFO -->
        <div class="login-info">
            <h1>Academic Portal</h1>
            <p>
                Hệ thống quản lý học tập và đào tạo tích hợp.<br />
                Truy cập dành cho sinh viên, giảng viên và quản trị viên.
            </p>
            <div class="tag">
                Trường Đại Học ABC – Since 2025
            </div>
        </div>

        <!-- RIGHT FORM -->
        <div class="login-form">

            <h3>Đăng nhập hệ thống</h3>
            <span>Vui lòng nhập thông tin tài khoản</span>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center" role="alert">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Login" asp-controller="Login" method="post" class="login-form-fields">
                <div class="mb-3">
                    <label for="username" class="form-label">Tài khoản</label>
                    <input type="text"
                           class="form-control"
                           id="username"
                           name="username"
                           placeholder="Mã số / tên đăng nhập"
                           required />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <input type="password"
                           class="form-control"
                           id="password"
                           name="password"
                           placeholder="Mật khẩu"
                           required />
                </div>

                <button type="submit" class="btn btn-primary btn-login w-100">
                    ĐĂNG NHẬP
                </button>
            </form>

            <div class="footer">
                © 2025 WebQuanLiKhoaHoc System
            </div>
        </div>

    </div>

</body>
</html>
