@model IEnumerable<WebQuanLiKhoaHoc_MVC.Models.HocVien.ClassEnrollmentViewModel>
<div class="container mt-5">
    <div class="p-4 mb-4 shadow-sm bg-white" style="border-radius: 20px; border-left: 8px solid #007bff;">
        <h2 class="fw-bold text-dark mb-1">DANH SÁCH MÔN HỌC MỞ</h2>
        <p class="text-muted small">Chọn lớp học phù hợp để bắt đầu hành trình kiến thức của bạn.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["Error"]</div>
    }

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg h-100" style="border-radius: 25px; background: rgba(255, 255, 255, 0.9);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="badge bg-primary px-3 py-2">@item.ClassCode</span>
                            <span class="text-muted fw-bold">ID: #@item.ClassId</span>
                        </div>
                        <h5 class="fw-bold mb-3">@item.CourseName</h5>
                        <p class="text-muted small mb-2"><i class="fas fa-user-circle me-2"></i>@item.LecturerName</p>

                        <div class="bg-light p-3 rounded-4 mb-3">
                            <label class="small fw-bold text-secondary d-block mb-1">Thời gian học:</label>
                            @foreach (var s in item.Schedules)
                            {
                                <div class="small"><i class="far fa-clock me-2"></i>Thứ @s.DayOfWeek: @s.StartTime - @s.EndTime</div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-end">
                            <div>
                                <small class="text-muted d-block">Sĩ số</small>
                                <span class="fw-bold @(item.EnrolledCount >= item.Capacity ? "text-danger" : "text-success")">
                                    @item.EnrolledCount / @item.Capacity
                                </span>
                            </div>
                            <form asp-action="Enroll" method="post">
                                <input type="hidden" name="classId" value="@item.ClassId" />
                                <button type="submit" class="btn btn-dark px-4 rounded-pill" @(item.EnrolledCount >= item.Capacity ? "disabled" : "")>
                                    Đăng ký
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
</div>