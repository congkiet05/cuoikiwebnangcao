@model IEnumerable<WebQuanLiKhoaHoc_MVC.Models.HocVien.Announcement>

@{
    ViewData["Title"] = "Thông báo chung";
    Layout = "~/Views/Shared/_LayoutStudent.cshtml"; // Đảm bảo đường dẫn Layout đúng
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary fw-bold border-bottom pb-2">
                <i class="bi bi-megaphone-fill me-2"></i>Thông Báo Chung
            </h2>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 hover-effect">
                        <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-info text-dark rounded-pill">Thông báo</span>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                            <h5 class="card-title text-dark fw-bold text-truncate-2">@item.Title</h5>
                        </div>
                        <div class="card-body px-4">
                            <p class="card-text text-secondary text-truncate-3">
                                @item.Body
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0 px-4 pb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted fst-italic">Đăng bởi: <strong>@item.Author</strong></small>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#modal-@item.Id">
                                    Xem chi tiết
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="modal-@item.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">@item.Title</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="d-flex justify-content-between mb-3 text-muted border-bottom pb-2">
                                    <span><i class="bi bi-person-circle me-1"></i> @item.Author</span>
                                    <span><i class="bi bi-calendar-event me-1"></i> @item.CreatedAt.ToString("HH:mm dd/MM/yyyy")</span>
                                </div>
                                <div class="content-body" style="white-space: pre-line;">
                                    @item.Body
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted display-1"><i class="bi bi-inbox"></i></div>
                <p class="mt-3 fs-5 text-secondary">Hiện chưa có thông báo nào.</p>
            </div>
        }
    </div>
</div>

<style>
    /* CSS trang trí thêm */
    .hover-effect {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
