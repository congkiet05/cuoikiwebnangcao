@model WebQuanLiKhoaHoc_MVC.Models.HocVien.HoSoHocVien
@{
	ViewData["Title"] = "Hồ sơ học viên";
}
<div class="container mt-4">
    <h2>Thông tin hồ sơ học viên</h2>
    <hr />

    @if (Model != null)
    {
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Mã học viên:</div>
                    <div class="col-sm-9">@Model.MaHocVien</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Họ và tên:</div>
                    <div class="col-sm-9">@Model.HoVaTen</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Ngày sinh:</div>
                    <div class="col-sm-9">@Model.NgaySinh?.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Ngành học:</div>
                    <div class="col-sm-9">@Model.NganhHoc</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 font-weight-bold">Khóa nhập học:</div>
                    <div class="col-sm-9">@Model.KhoaNhapHoc</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">Không có dữ liệu để hiển thị.</div>
    }
</div>


