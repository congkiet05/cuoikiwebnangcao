

<h2 class="mb-4">Lịch học của bạn</h2>

@if (!Model.Any())
{
	<div class="alert alert-info">Không có buổi học nào.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Mã KH</th>
                <th>Tên KH</th>
                <th>Lớp</th>
                <th>Học kỳ</th>
                <th>Giảng viên</th>
                <th>Thứ</th>
                <th>Bắt đầu</th>
                <th>Kết thúc</th>
                <th>Phòng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.MaKhoaHoc</td>
                    <td>@s.TenKhoaHoc</td>
                    <td>@s.MaLopHoc</td>
                    <td>@s.HocKy</td>
                    <td>@s.TenGiangVien</td>
                    <td>@s.NgayTrongTuan</td>
                    <td>@s.ThoiGianBatDau.ToString("HH:mm")</td>
                    <td>@s.ThoiGianKetThuc.ToString("HH:mm")</td>
                    <td>@s.PhongHoc</td>
                </tr>
            }
        </tbody>
    </table>
}