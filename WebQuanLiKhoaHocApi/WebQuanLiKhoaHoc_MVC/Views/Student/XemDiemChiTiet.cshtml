@model List<WebQuanLiKhoaHoc_MVC.Models.HocVien.HocVien_XemDiemMonModels>
@* 1. Import namespace chứa Model Bài Tập *@
@using WebQuanLiKhoaHoc_MVC.Models.HocVien

@{
    ViewData["Title"] = "Chi Tiết Điểm Môn Học";

    // 2. Lấy danh sách bài tập từ Controller gửi sang
    var listBaiTap = ViewBag.ListBaiTapChuaNop as List<BaiTapCanNopViewModel>;
    int soLuongBaiTap = (listBaiTap != null) ? listBaiTap.Count : 0;
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Chi Tiết Điểm Thành Phần</h2>

    @* 3. Khu vực các nút điều hướng *@
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a href="@Url.Action("XemDiemTrungBinh", "XemDiem", new { MaHocVien = ViewBag.MaHocVien })" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Quay lại bảng điểm tổng
        </a>

        @if (soLuongBaiTap > 0)
        {
            <button type="button" class="btn btn-danger position-relative" data-bs-toggle="modal" data-bs-target="#modalBaiTap">
                <i class="fa fa-bell"></i> Bài tập cần làm
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark border border-light">
                    @soLuongBaiTap
                    <span class="visually-hidden">bài tập chưa nộp</span>
                </span>
            </button>
        }
        else
        {
            <button class="btn btn-success disabled" style="opacity: 0.7">
                <i class="fa fa-check-circle"></i> Đã hoàn thành hết bài tập
            </button>
        }
    </div>

    @* Phần hiển thị bảng điểm (Giữ nguyên code cũ của bạn) *@
    @if (Model != null && Model.Count > 0)
    {
        <div class="alert alert-primary">
            <strong>Mã SV:</strong> @Model[0].StudentNumber - <strong>Tên SV:</strong> @Model[0].FullName <br />
            <strong>Môn học:</strong> @Model[0].CourseName (@Model[0].CourseCode)
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Tên Bài Tập / Đầu Điểm</th>
                        <th>Ngày Tạo</th>
                        <th>Hạn Nộp</th>
                        <th>Ngày Nộp</th>
                        <th class="text-center">Điểm Số</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AssignmentTitle</td>
                            <td>@(item.CreatedAt.HasValue? item.CreatedAt.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>@(item.DueDate.HasValue? item.DueDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>
                                @if (item.SubmittedAt.HasValue)
                                {
                                    @item.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Chưa nộp</span>
                                }
                            </td>
                            <td class="text-center fw-bold">
                                @if (item.Grade.HasValue)
                                {
                                    @item.Grade
                                }
                                else
                                {
                                    <span class="text-warning">Chưa chấm</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            Chưa có dữ liệu điểm thành phần cho môn học này.
        </div>
    }
</div>

@* 4. MODAL (POPUP) HIỂN THỊ DANH SÁCH BÀI TẬP CẦN NỘP *@
<div class="modal fade" id="modalBaiTap" tabindex="-1" aria-labelledby="modalBaiTapLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalBaiTapLabel">
                    <i class="fa fa-exclamation-triangle"></i> Danh Sách Bài Tập Chưa Hoàn Thành
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (listBaiTap != null && listBaiTap.Any())
                {
                    <div class="list-group">
                        @foreach (var bt in listBaiTap)
                        {
                            <div class="list-group-item list-group-item-action" aria-current="true">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1 text-primary">@bt.TieuDe</h5>
                                        <small class="text-muted">
                                            <i class="fa fa-calendar"></i> Hạn nộp:
                                            <span class="fw-bold @(bt.TrangThai == "Quá hạn" ? "text-danger" : "text-dark")">
                                                @(bt.HanNop.HasValue? bt.HanNop.Value.ToString("dd/MM/yyyy HH:mm") : "Không thời hạn")
                                            </span>
                                        </small>
                                        <p class="mb-1 mt-1">
                                            Trạng thái:
                                            @if (bt.TrangThai == "Quá hạn")
                                            {
                                                <span class="badge bg-danger">Quá hạn nộp</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Đang mở</span>
                                            }
                                        </p>
                                    </div>

                                    <div>
                                        <a href="@Url.Action("ChiTiet", "BaiTap", new { id = bt.AssignmentId })" class="btn btn-primary">
                                            <i class="fa fa-upload"></i> Nộp bài
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-muted">Không có bài tập nào cần nộp.</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>