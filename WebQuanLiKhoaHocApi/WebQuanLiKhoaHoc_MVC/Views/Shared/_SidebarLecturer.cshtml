<div class="user-info text-start mb-4 border-bottom pb-3">
    <div class="d-flex align-items-center">
        <img src="~/images/avatar.jpg" alt="Dr. Doe" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;">
        <div>
            <h6 id="sidebar-fullname" class="mb-0 fw-bold">Dr. Jane Doe</h6>
            <p class="text-muted small mb-0">Lecturer</p>
        </div>
    </div>
</div>

<ul class="nav flex-column mb-auto">
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

        // Hàm kiểm tra trang đang hoạt động
        Func<string, string, string> GetActive = (actionName, controllerName) =>
        (currentController == controllerName && currentAction == actionName) ? "active bg-primary text-white" : "text-secondary";
    }

    <li class="nav-item mb-2">
        <a class="nav-link @GetActive("Dashboard", "Lecturer") rounded p-2" href="@Url.Action("Dashboard", "Lecturer")">
            <i class="bi bi-grid-fill me-2"></i> Dashboard
        </a>
    </li>

    <li class="nav-item mb-2">
        <a class="nav-link @GetActive("Announcement", "Lecturer") rounded p-2" href="@Url.Action("Announcement", "Lecturer")">
            <i class="bi bi-megaphone-fill me-2"></i> Announcement
        </a>
    </li>

    <li class="nav-item mb-2">
        <a class="nav-link @GetActive("Notification", "Lecturer") rounded p-2" href="@Url.Action("Notification", "Lecturer")">
            <i class="bi bi-bell-fill me-2"></i> Notification
        </a>
    </li>

    <li class="nav-item mb-2">
        <a class="nav-link @GetActive("Message", "Lecturer") rounded p-2" href="@Url.Action("Message", "Lecturer")">
            <i class="bi bi-chat-dots-fill me-2"></i> Message
        </a>
    </li>

    <li class="nav-item mb-2">
        <a class="nav-link @GetActive("Timetable", "Lecturer") rounded p-2" href="@Url.Action("Timetable", "Lecturer")">
            <i class="bi bi-calendar-week-fill me-2"></i> Timetable
        </a>
    </li>

    <li class="nav-item mb-2">
        <a class="nav-link @GetActive("Assignment", "Lecturer") rounded p-2" href="@Url.Action("Assignment", "Lecturer")">
            <i class="bi bi-file-earmark-check-fill me-2"></i> Assignment
        </a>
    </li>

    <li class="nav-item mb-2">
        <a class="nav-link @GetActive("Profile", "Lecturer") rounded p-2" href="@Url.Action("Profile", "Lecturer")">
            <i class="bi bi-person-circle me-2"></i> Profile
        </a>
    </li>
</ul>

<hr class="mt-auto" />
<ul class="nav flex-column">
    <li class="nav-item mb-2">
        <a class="nav-link text-secondary @GetActive("Settings", "Lecturer") rounded p-2" href="@Url.Action("Settings", "Lecturer")">
            <i class="bi bi-gear-fill me-2"></i> Settings
        </a>
    </li>
    <li class="nav-item mb-2">
        <a class="nav-link text-secondary @GetActive("Help", "Lecturer") rounded p-2" href="@Url.Action("Help", "Lecturer")">
            <i class="bi bi-question-circle-fill me-2"></i> Help
        </a>
    </li>
    <li class="nav-item mb-2 mt-3">
        <a class="nav-link text-danger rounded p-2" href="@Url.Action("Logout", "Login")">
            <i class="bi bi-box-arrow-right me-2"></i> Logout
        </a>
    </li>
</ul>