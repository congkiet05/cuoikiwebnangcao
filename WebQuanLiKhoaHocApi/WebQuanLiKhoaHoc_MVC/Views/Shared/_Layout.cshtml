<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Phòng GD&ĐT Hà Nội</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <style>
        .logo-box {
            width: 100px; /* Giới hạn chiều rộng khung logo */
            height: 100px; /* Giới hạn chiều cao khung logo */
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden; /* Ẩn phần thừa nếu ảnh quá to */
        }

            /* Định dạng ảnh bên trong logo */
            .logo-box img {
                max-width: 100%; /* Ảnh không bao giờ vượt quá khung chứa */
                max-height: 100%; /* Ảnh không bao giờ cao quá khung chứa */
                object-fit: contain; /* Giúp ảnh tự co lại cho vừa khung mà không bị méo */
            }
    </style>
</head>

<body>
    <header>
        <div class="top-banner text-center">
            <div class="container d-flex align-items-center">
                <div class="logo-box me-3">
                    <img src="~/images/LogoTruongDaihoc.jpg" alt="Alternate Text" />
                </div>
                <div>
                    <h3 class="m-0">Phòng giáo dục và đào tạo</h3>
                    <h2 class="m-0">Thành phố Hà Nội</h2>
                </div>
            </div>
        </div>

        <nav class="menu-bar">
            <div class="container d-flex">
                <a href="#">TRANG NHẤT</a>
                <a href="#">GIỚI THIỆU CHUNG</a>
                <a href="#">TIN TỨC - SỰ KIỆN</a>
                <a href="#">QUẢN LÝ ĐIỀU HÀNH</a>
                <a href="#">LIÊN HỆ</a>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="footer-box mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-5">
                    <h5 class="footer-title">PHÒNG GIÁO DỤC VÀ ĐÀO TẠO THÀNH PHỐ HÀ NỘI</h5>
                    <p><i class="fas fa-map-marker-alt"></i> Địa chỉ: Số... Đường..., Quận..., TP. Hà Nội</p>
                    <p><i class="fas fa-phone"></i> Điện thoại: (024) XXXX XXXX</p>
                    <p><i class="fas fa-envelope"></i> Email: phonggddt_hanoi@hanoi.gov.vn</p>
                </div>

                <div class="col-md-3">
                    <h5 class="footer-title">LIÊN KẾT NHANH</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">Sở Giáo dục & Đào tạo</a></li>
                        <li><a href="#">Cổng thông tin Chính phủ</a></li>
                        <li><a href="#">Tra cứu văn bản pháp quy</a></li>
                    </ul>
                </div>

                <div class="col-md-4 text-md-end">
                    <h5 class="footer-title">KẾT NỐI VỚI CHÚNG TÔI</h5>
                    <div class="social-links mb-3">
                        <a href="#" class="me-3"><i class="fab fa-facebook fa-2x"></i></a>
                        <a href="#"><i class="fab fa-youtube fa-2x"></i></a>
                    </div>
                    <p>Đang trực tuyến: <strong>125</strong></p>
                    <p>Tổng lượt truy cập: <strong>1,250,430</strong></p>
                </div>
            </div>
        </div>

        <div class="footer-bottom text-center py-3">
            <p class="mb-0">© 2024 Bản quyền thuộc về Phòng GD&ĐT Thành phố Hà Nội.</p>
        </div>
    </footer>

    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>