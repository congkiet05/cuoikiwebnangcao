<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Phòng GD&ĐT Hà Nội</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/style.css">
</head>

<body>
    <header>
        <div class="top-banner text-center">
            <div class="container d-flex align-items-center">
                <div class="logo-box me-3"></div>
                <div>
                    <h3 class="m-0">Phòng giáo dục và đào tạo</h3>
                    <h2 class="m-0">Thành phố Hà Nội</h2>
                </div>
            </div>
        </div>

        <nav class="menu-bar">
            <div class="container d-flex">
                <a href="#">TRANG NHẤT</a>
                <a href="#">GIỚI THIỆU CHUNG</a>
                <a href="#">TIN TỨC - SỰ KIỆN</a>
                <a href="#">QUẢN LÝ ĐIỀU HÀNH</a>
                <a href="#">LIÊN HỆ</a>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        <div class="row">

            <!-- Cột trái: sidebar -->
            <div class="col-md-3">
                @await Html.PartialAsync("_StudentSidebar")
            </div>

            <!-- Cột giữa: nội dung các trang -->
            <div class="col-md-6">
                @RenderBody()
            </div>

            <!-- Cột phải: thông báo -->
            <div class="col-md-3 notice-column">
                @await Html.PartialAsync("_StudentNotice")
            </div>

        </div>
    </main>



    <footer class="footer-box text-center mt-4">
        <p>Footer mẫu </p>
    </footer>

    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>