@* Views/Shared/_StudentSidebar.cshtml *@
@{
    // Lấy Username (Mã học viên) từ Identity của người dùng đã đăng nhập
    var currentMaHocVien = User.Identity?.Name ?? "";
}
<div class="sidebar-title">HỌC VIÊN</div>

<a href="@Url.Action("Dashboard", "Student")" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-grid-1x2-fill me-2"></i>
    <span>Dashboard</span>
</a>

<a href="#" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-megaphone me-2"></i>
    <span>Thông báo chung</span>
</a>

<a href="@Url.Action("Index", "Announcement")" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-bell me-2"></i>
    <span>Thông báo hệ thống</span>
</a>

<a href="@Url.Action("Message","Student")" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-chat-dots me-2"></i>
    <span>Tin nhắn</span>
</a>

<a href="@Url.Action("LichHoc", "LichHoc")" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-calendar-event me-2"></i>
    <span>Lịch học</span>
</a>

<a href="@Url.Action("XemDiemTrungBinh", "XemDiem")" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-file-earmark-text me-2"></i>
    <span>Bài tập / Assignment</span>
</a>

<a href="@Url.Action("HoSoHocVien", "HoSoHocVien", new { MaHocVien = currentMaHocVien })"
   class="sidebar-item d-flex align-items-center">
    <i class="bi bi-person-circle me-2"></i>
    <span>Hồ sơ cá nhân</span>
</a>
<a href="@Url.Action("XemDiemTrungBinh", "XemDiem")" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-file-earmark-text me-2"></i>
    <span>Xem Điểm</span>
</a>

<a href="#" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-file-earmark-text me-2"></i>
    <span>Đăng Kí Môn Học</span>
</a>
<hr class="my-2" />

<a href="#settingsSubmenu" data-bs-toggle="collapse" class="sidebar-item d-flex align-items-center justify-content-between" aria-expanded="false">
    <div class="d-flex align-items-center">
        <i class="bi bi-gear me-2"></i>
        <span>Cài đặt</span>
    </div>
    <i class="bi bi-chevron-down small" style="font-size: 0.8rem;"></i>
</a>

<div class="collapse" id="settingsSubmenu">
    <a href="@Url.Action("Logout", "Login")" class="sidebar-item d-flex align-items-center ps-4 text-danger">
        <i class="bi bi-box-arrow-right me-2"></i>
        <span>Đăng xuất</span>
    </a>
</div>

<a href="#" class="sidebar-item d-flex align-items-center">
    <i class="bi bi-question-circle me-2"></i>
    <span>Trợ giúp</span>
</a>


