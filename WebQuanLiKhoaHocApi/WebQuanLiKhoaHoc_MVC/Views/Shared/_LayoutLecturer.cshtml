<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Course Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        /* Sidebar Settings */
        #sidebar-wrapper {
            width: 250px; /* Chiều rộng Sidebar khi mở */
            min-height: 100vh;
            transition: margin-left .3s ease-out; /* Hiệu ứng chuyển động */
            padding: 0;
        }

        /* Toggled State (Sidebar Ẩn) */
        body.toggled #sidebar-wrapper {
            margin-left: -250px; /* Ẩn Sidebar */
        }

        /* Toggled State (Content) - Để nội dung full width khi Sidebar ẩn */
        body.toggled #content-wrapper {
            width: 100vw;
        }

        .topbar {
            height: 70px;
            display: flex;
            align-items: center;
        }
    </style>

</head>

<body id="page-top" class="toggled">
    <div id="wrapper" class="d-flex">

        <div class="sidebar-wrapper bg-white shadow-sm" id="sidebar-wrapper">
            @Html.Partial("_Sidebar")
        </div>

        <div id="content-wrapper" class="d-flex flex-column flex-grow-1">

            <div id="content">

                <nav class="navbar navbar-expand navbar-light bg-white topbar static-top shadow-sm border-bottom">

                    <button id="sidebarToggle" class="btn btn-link rounded-circle ms-3">
                        <i class="bi bi-list fs-4"></i>
                    </button>

                    <div class="p-2">
                        <h1 class="h3 mb-0 text-gray-800">@ViewBag.Title</h1>
                    </div>
                </nav>

                <div class="container-fluid p-4">
                    @RenderBody()
                </div>

            </div>

        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            // Khi người dùng click vào nút Toggle (|||)
            $("#sidebarToggle").on('click', function(e) {
                e.preventDefault();
                // ✅ Thao tác này sẽ xóa hoặc thêm class "toggled" vào thẻ <body>
                // CSS sẽ tự động ẩn/hiện Sidebar dựa vào class này
                $("body").toggleClass("toggled");
            });
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>