<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Course Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        /* Sidebar Settings */
        #sidebar-wrapper {
            width: 250px; /* Chiều rộng Sidebar khi mở */
            min-height: 100vh;
            transition: margin-left .3s ease-out; /* Hiệu ứng chuyển động */
            padding: 10px 0 0 10px;
			box-sizing: border-box;
        }

        /* Toggled State (Sidebar Ẩn) */
        body.toggled #sidebar-wrapper {
            margin-left: -250px; /* Ẩn Sidebar */
        }

        /* Toggled State (Content) - Để nội dung full width khi Sidebar ẩn */
        body.toggled #content-wrapper {
            width: 100vw;
        }

        .topbar {
            height: 70px;
            display: flex;
            align-items: center;
        }

        #sidebar-wrapper .nav-link:hover {
            opacity: 0.7 !important; /* Giảm độ mờ */
            background-color: #f8f9fa; /* Nền xám cực nhẹ */
            transform: translateX(5px); /* Nhích sang phải 5px */
            color: #0d6efd !important; /* Đổi màu chữ sang xanh primary khi hover */
        }

        /* Định nghĩa màu sắc cho Dark Mode */
        body.dark-mode {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }

            body.dark-mode .card,
            body.dark-mode #sidebar-wrapper,
            body.dark-mode .topbar {
                background-color: #1e1e1e !important;
                border-color: #333 !important;
                color: #fff !important;
            }

            body.dark-mode .nav-link:not(.active) {
                color: #bbb !important;
            }

            body.dark-mode .text-muted {
                color: #888 !important;
            }

            body.dark-mode .list-group-item {
                background-color: #1e1e1e !important;
                color: #fff !important;
                border-color: #333 !important;
            }

        /* Hiệu ứng chuyển mượt cho toàn trang */
        body {
            transition: background-color 0.3s ease, color 0.3s ease;
        }
    </style>

</head>

<body id="page-top" class="toggled">
    <script>
        // Chạy ngay lập tức trước khi render nội dung để tránh nháy sáng
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-mode');
        }
    </script>
    <div id="wrapper" class="d-flex">

        <div class="sidebar-wrapper bg-white shadow-sm" id="sidebar-wrapper">
            @Html.Partial("_SidebarLecturer")
        </div>

        <div id="content-wrapper" class="d-flex flex-column flex-grow-1">

            <div id="content">

                <nav class="navbar navbar-expand navbar-light bg-white topbar static-top shadow-sm border-bottom">

                    <button id="sidebarToggle" class="btn btn-link rounded-circle ms-3">
                        <i class="bi bi-list fs-4"></i>
                    </button>

                    <div class="p-2">
                        <h1 class="h3 mb-0 text-gray-800">@ViewBag.Title</h1>
                    </div>
                </nav>

                <div class="container-fluid p-4">
                    @RenderBody()
                </div>

            </div>

        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            // --- 1. XỬ LÝ ĐÓNG/MỞ SIDEBAR (TOGGLE) ---
            $("#sidebarToggle").on('click', function(e) {
                e.preventDefault();
                $("body").toggleClass("toggled");
            });

            // --- 2. CẬP NHẬT THÔNG TIN GIẢNG VIÊN THẬT ---
            // Lấy dữ liệu từ ViewBag truyền xuống từ LecturerController
            const fullName = "@ViewBag.CurrentUserName";
            const lecturerId = "@ViewBag.CurrentUserId";
            const token = "@ViewBag.AccessToken"; // Dùng nếu bạn muốn gọi thêm API khác

            if (fullName && fullName !== "" && fullName !== "Giảng viên") {
                // Cập nhật tên lên Sidebar
                $('#sidebar-fullname').text(fullName);

                // Cập nhật ảnh đại diện dựa trên tên thật (UI Avatars)
                const avatarUrl = `https://ui-avatars.com/api/?name=${encodeURIComponent(fullName)}&background=0d6efd&color=fff`;

                // Đảm bảo ID thẻ img trong Sidebar là 'sidebar-avatar'
                $('#sidebar-avatar').attr('src', avatarUrl);
            } else {
                // Trường hợp dự phòng nếu ViewBag trống
                $('#sidebar-fullname').text("Giảng viên");
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>