@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";

    // @model YourNamespace.Models.LecturerProfile
}

<div class="card p-4 shadow-sm">

    <h2 class="h4 mb-1">My Profile</h2>
    <p class="text-muted mb-4">Update your personal and professional information.</p>

    @using (Html.BeginForm("UpdateProfile", "Lecturer", FormMethod.Post, new { id = "profileForm" }))
    {
        @* @Html.AntiForgeryToken() *@

        <div class="row">
            <div class="col-lg-4 mb-4">
                <div class="p-3 text-center border rounded h-100">

                    <div class="position-relative d-inline-block mb-3">
                        <img src="~/images/avatar.jpg" alt="Avatar" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;">
                        <a href="#" class="btn btn-sm btn-light rounded-circle position-absolute top-0 start-100 translate-middle border border-primary p-1">
                            <i class="bi bi-pencil" style="font-size: 0.75rem;"></i>
                        </a>
                    </div>

                    <h5>Dr. Jane Doe</h5>
                    <p class="text-muted mb-1">Associate Professor</p>
                    <p class="text-muted small">Department of Computer Science</p>

                    <h6 class="text-start mt-4 mb-2 border-top pt-3">Bio</h6>
                    <textarea class="form-control" rows="4">Passionate about machine learning and its applications in healthcare. Committed to fostering a dynamic and inclusive learning environment.</textarea>

                </div>
            </div>

            <div class="col-lg-8">

                <h5 class="mb-3">Contact Information</h5>
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <label class="form-label small text-muted">Email Address</label>
                        <input type="email" class="form-control" value="jane.doe@university.edu" readonly>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label small text-muted">Phone Number</label>
                        <input type="text" class="form-control" value="(123) 456-7890">
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label small text-muted">Office Location</label>
                        <input type="text" class="form-control" value="Science Building, Room 302">
                    </div>
                </div>

                <h5 class="mb-3">Academic Background</h5>
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
                        <div>
                            <strong>Ph.D. in Computer Science</strong>
                            <p class="text-muted small mb-0">Stanford University, 2012</p>
                        </div>
                        <a href="#" class="btn btn-sm text-secondary p-0"><i class="bi bi-pencil"></i></a>
                    </div>
                    <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
                        <div>
                            <strong>M.S. in Computer Science</strong>
                            <p class="text-muted small mb-0">Stanford University, 2008</p>
                        </div>
                        <a href="#" class="btn btn-sm text-secondary p-0"><i class="bi bi-pencil"></i></a>
                    </div>
                    <a href="#" class="btn btn-link btn-sm"><i class="bi bi-plus-circle me-1"></i> Add Qualification</a>
                </div>

                <h5 class="mb-3">Research Interests</h5>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-primary text-white p-2">Machine Learning <a href="#" class="text-white ms-1" style="text-decoration: none;">&times;</a></span>
                    <span class="badge bg-primary text-white p-2">AI Ethics <a href="#" class="text-white ms-1" style="text-decoration: none;">&times;</a></span>
                    <span class="badge bg-primary text-white p-2">Computational Biology <a href="#" class="text-white ms-1" style="text-decoration: none;">&times;</a></span>
                </div>
                <input type="text" class="form-control" placeholder="Add Interest...">

            </div>
        </div>

        <hr class="mt-5 mb-3" />
        <div class="d-flex justify-content-end">
            <a href="@Url.Action("Dashboard", "Lecturer")" class="btn btn-light me-2">Cancel</a>

            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    }

</div>