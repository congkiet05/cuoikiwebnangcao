@{
    ViewBag.Title = "Messages";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";
}

<style>
    /* CSS Tùy chỉnh (Nên được đưa vào Site.css nếu có thể) */
    .message-container {
        display: flex;
        height: calc(100vh - 120px); /* Đảm bảo đủ chiều cao màn hình */
        min-height: 650px;
        overflow: hidden;
    }

    .chat-panel {
        overflow-y: auto;
        border-right: 1px solid #eee;
    }

    .chat-window {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .chat-body {
        flex-grow: 1;
        overflow-y: auto;
        padding: 20px;
        background-color: #f7f9fc; /* Màu nền cho khu vực chat */
    }

    .detail-panel {
        max-width: 250px;
        min-width: 250px;
        border-left: 1px solid #eee;
    }

    .message-item.active {
        background-color: #eaf3ff;
        border-left: 3px solid #0d6efd;
    }
</style>


<div class="message-container border rounded shadow-sm">

    <div class="chat-panel bg-white p-3 flex-shrink-0" style="width: 300px;">
        <div class="d-flex align-items-center mb-3">
            <h5 class="mb-0 fw-bold">Dr. Eleanor Vance</h5>
            <span class="ms-2 badge bg-success-subtle text-success">Online</span>
        </div>

        <div class="input-group mb-3">
            <input type="text" class="form-control" placeholder="Search students or groups..." aria-label="Search">
        </div>

        <button class="btn btn-primary w-100 mb-3"><i class="bi bi-chat-dots me-1"></i> New Message</button>

        <div class="list-group list-group-flush">

            @* Thread Hoạt động (Jane Doe) *@
            <a href="#" class="list-group-item list-group-item-action message-item active p-3">
                <div class="d-flex align-items-center">
                    <img src="~/images/avatar.jpg" class="rounded-circle me-3" style="width: 40px; height: 40px;">
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between small">
                            <span class="fw-bold">Jane Doe</span>
                            <span class="text-muted">10:42 AM</span>
                        </div>
                        <p class="mb-0 text-truncate small">Hi Professor, I had a question about...</p>
                    </div>
                </div>
            </a>

            @* Thread khác (CS101) *@
            <a href="#" class="list-group-item list-group-item-action message-item p-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-folder-fill text-primary me-3" style="font-size: 20px;"></i>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between small">
                            <span class="fw-bold">CS101 - Final Project Group</span>
                            <span class="text-muted">Yesterday</span>
                        </div>
                        <p class="mb-0 text-truncate small text-danger">Attachment: project_brief.pdf</p>
                    </div>
                </div>
            </a>

            @* Thread khác (Alex Ray) *@
            <a href="#" class="list-group-item list-group-item-action message-item p-3">
                <div class="d-flex align-items-center">
                    <img src="~/images/avatar.jpg" class="rounded-circle me-3" style="width: 40px; height: 40px;">
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between small">
                            <span class="fw-bold">Alex Ray</span>
                            <span class="text-muted">Mon</span>
                        </div>
                        <p class="mb-0 text-truncate small">You: Sounds good, see you then.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="flex-grow-1 chat-window">

        <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-light flex-shrink-0">
            <div>
                <h5 class="mb-0">Jane Doe</h5>
                <span class="small text-muted">Online</span>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-telephone"></i></button>
                <button class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-camera-video"></i></button>
                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-three-dots-vertical"></i></button>
            </div>
        </div>

        <div class="chat-body">

            @* Tin nhắn đến (Incoming) *@
            <div class="d-flex mb-3">
                <img src="~/images/avatar.jpg" class="rounded-circle me-2 flex-shrink-0" style="width: 30px; height: 30px;">
                <div>
                    <div class="small text-muted mb-1">Jane Doe · 10:42 AM</div>
                    <div class="p-2 rounded bg-white shadow-sm" style="max-width: 70%;">
                        Hi Professor, I had a question about the assignment deadline. Can you clarify when it is due?
                    </div>
                </div>
            </div>

            @* Tin nhắn đi (Outgoing) *@
            <div class="d-flex justify-content-end mb-3">
                <div>
                    <div class="small text-muted text-end mb-1">You · 10:43 AM</div>
                    <div class="p-2 rounded bg-primary text-white shadow-sm" style="max-width: 70%;">
                        Hello Jane, of course. The deadline is this Friday at 11:59 PM. Let me know if you have any other questions.
                    </div>
                </div>
                <img src="~/images/avatar.jpg" class="rounded-circle ms-2 flex-shrink-0" style="width: 30px; height: 30px;">
            </div>

            @* Tin nhắn đến (Incoming) *@
            <div class="d-flex mb-3">
                <img src="~/images/avatar.jpg" class="rounded-circle me-2 flex-shrink-0" style="width: 30px; height: 30px;">
                <div>
                    <div class="small text-muted mb-1">Jane Doe · 10:45 AM</div>
                    <div class="p-2 rounded bg-white shadow-sm" style="max-width: 70%;">
                        Perfect, thank you so much for the quick response!
                    </div>
                </div>
            </div>

        </div>

        <div class="p-3 border-top bg-light flex-shrink-0">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Type a message...">
                <button class="btn btn-outline-secondary"><i class="bi bi-paperclip"></i></button>
                <button class="btn btn-primary"><i class="bi bi-send-fill"></i></button>
            </div>
        </div>
    </div>

    <div class="detail-panel bg-white p-3 flex-shrink-0">
        <h6 class="text-center fw-bold border-bottom pb-2 mb-3">Details</h6>

        <div class="text-center mb-4">
            <img src="~/images/avatar.jpg" class="rounded-circle mb-2" style="width: 80px; height: 80px;">
            <h6 class="mb-0">Jane Doe</h6>
            <p class="small text-muted">Student ID: 458221</p>
            <span class="badge bg-info-subtle text-info">Enrolled in CS101, PHYS203</span>
        </div>

        <h6 class="small fw-bold text-uppercase text-muted mb-2">Pinned Messages</h6>
        <div class="p-2 bg-light border rounded mb-3 small">
            Prof. Vance: Remember the deadline is this Friday!
        </div>

        <h6 class="small fw-bold text-uppercase text-muted mb-2">Shared Files</h6>
        <ul class="list-group list-group-flush small">
            <li class="list-group-item d-flex align-items-center px-0">
                <i class="bi bi-file-earmark-pdf text-danger me-2" style="font-size: 1.2rem;"></i>
                <div class="flex-grow-1">Lecture_Notes_Week5.pdf</div>
                <span class="text-muted">1.2 MB</span>
            </li>
            <li class="list-group-item d-flex align-items-center px-0">
                <i class="bi bi-file-earmark-word text-primary me-2" style="font-size: 1.2rem;"></i>
                <div class="flex-grow-1">Assignment_Guidelines.docx</div>
                <span class="text-muted">245 KB</span>
            </li>
            <li class="list-group-item d-flex align-items-center px-0">
                <i class="bi bi-file-earmark-image text-warning me-2" style="font-size: 1.2rem;"></i>
                <div class="flex-grow-1">lab_diagram.png</div>
                <span class="text-muted">890 KB</span>
            </li>
        </ul>
    </div>

</div>