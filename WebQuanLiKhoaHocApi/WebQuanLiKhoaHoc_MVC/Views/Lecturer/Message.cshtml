@{
    ViewBag.Title = "Class Messages";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";
}

<div class="container-fluid p-0 shadow-sm rounded-3 overflow-hidden bg-white" style="height: 80vh;">
    <div class="row g-0 h-100">
        <div class="col-md-4 col-lg-3 border-end h-100 d-flex flex-column">
            <div class="p-3 border-bottom bg-light">
                <h5 class="fw-bold mb-0">My Classes</h5>
            </div>
            <div class="list-group list-group-flush overflow-auto flex-grow-1" id="class-list">
                <div class="p-3 text-center text-muted small">Loading classes...</div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9 h-100 d-flex flex-column bg-light">
            <div id="chat-header" class="p-3 bg-white border-bottom d-none">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold" id="current-class-name">Class Name</h6>
                        <small class="text-success">Online Community</small>
                    </div>
                </div>
            </div>

            <div id="message-body" class="p-4 overflow-auto flex-grow-1 d-flex flex-column" style="background-image: url('https://www.transparenttextures.com/patterns/cubes.png');">
                <div class="m-auto text-center text-muted">
                    <i class="bi bi-chat-dots" style="font-size: 3rem;"></i>
                    <p>Select a class to start messaging</p>
                </div>
            </div>

            <div id="chat-input-area" class="p-3 bg-white border-top d-none">
                <div class="input-group">
                    <input type="text" id="message-input" class="form-control border-0 bg-light" placeholder="Type a message...">
                    <button class="btn btn-primary px-4" id="btn-send">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            const lecturerId = 2;
            const apiBaseUrl = "https://localhost:7274/api";
            let currentSelectedClass = null;

            // 1. Lấy danh sách lớp giảng viên dạy
            $.ajax({
                url: `${apiBaseUrl}/ClassSchedules/Lecturer/${lecturerId}`,
                type: "GET",
                success: function (data) {
                    // Lọc lấy danh sách ClassId duy nhất
                    const uniqueClasses = [...new Map(data.map(item => [item.classCode, item])).values()];
                    let html = '';
                    uniqueClasses.forEach(c => {
                        html += `
                            <a href="#" class="list-group-item list-group-item-action p-3 border-0 class-item" data-id="${c.classId}" data-name="${c.courseName}">
                                <div class="fw-bold">${c.courseCode}</div>
                                <div class="small text-muted text-truncate">${c.courseName}</div>
                            </a>`;
                    });
                    $('#class-list').html(html);
                }
            });

            // 2. Click vào lớp để xem tin nhắn
            $(document).on('click', '.class-item', function (e) {
                e.preventDefault();
                $('.class-item').removeClass('active bg-primary-subtle');
                $(this).addClass('active bg-primary-subtle');

                currentSelectedClass = $(this).data('id');
                const className = $(this).data('name');

                $('#chat-header, #chat-input-area').removeClass('d-none');
                $('#current-class-name').text(className);
                loadMessages(currentSelectedClass);
            });

            // 3. Hàm load tin nhắn (Fake hoặc từ API ClassMessage)
            function loadMessages(classId) {
                // Ở đây bạn sẽ gọi API: GET /api/ClassMessages/{classId}
                // Tạm thời hiển thị tin nhắn mẫu
                let html = `
                    <div class="message-item mb-3 align-self-start bg-white p-3 rounded shadow-sm" style="max-width: 70%;">
                        <small class="fw-bold text-primary">Student A</small>
                        <p class="mb-0">Thầy ơi, bài tập tuần này nộp ở đâu ạ?</p>
                        <small class="text-muted" style="font-size: 0.6rem;">10:30 AM</small>
                    </div>
                    <div class="message-item mb-3 align-self-end bg-primary text-white p-3 rounded shadow-sm" style="max-width: 70%;">
                        <p class="mb-0">Các em nộp vào mục Assignment trên hệ thống nhé.</p>
                        <small class="text-white-50" style="font-size: 0.6rem;">10:32 AM</small>
                    </div>
                `;
                $('#message-body').html(html).scrollTop($('#message-body')[0].scrollHeight);
            }

            // 4. Gửi tin nhắn
            $('#btn-send').click(function() {
                const msg = $('#message-input').val();
                if(msg.trim() !== "") {
                    // Gọi API POST /api/ClassMessages
                    // Sau đó append vào UI
                    $('#message-input').val('').focus();
                }
            });
        });
    </script>

    <style>
        .class-item {
            transition: all 0.2s;
            border-radius: 0 !important;
        }

            .class-item:hover {
                background-color: #f8f9fa;
            }

            .class-item.active {
                border-left: 4px solid #0d6efd !important;
            }

        #message-body::-webkit-scrollbar {
            width: 5px;
        }

        #message-body::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 10px;
        }

        /* Dark mode support */
        body.dark-mode .bg-light {
            background-color: #252525 !important;
        }

        body.dark-mode .bg-white {
            background-color: #1e1e1e !important;
        }

        body.dark-mode .border-bottom, body.dark-mode .border-end, body.dark-mode .border-top {
            border-color: #333 !important;
        }

        body.dark-mode .class-item {
            color: #eee;
        }

        body.dark-mode .message-item.bg-white {
            background-color: #2d2d2d !important;
            color: #fff;
        }
    </style>
}