@using Microsoft.AspNetCore.Mvc.Rendering
@* Sử dụng @model nếu bạn dùng ViewModel thay vì ViewBag *@
@{
    ViewBag.Title = "Announcement Management";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";

    // Lấy LecturerId từ Controller (được gán trong Action)
    // Giá trị này được sử dụng trong trường ẩn AuthorId
    var currentLecturerId = 3;
}

<style>
    /* CSS cho khu vực tải tệp đính kèm */
    .attachment-area {
        border: 2px dashed #dee2e6;
        transition: all 0.2s;
        cursor: pointer;
    }

        .attachment-area:hover {
            border-color: #007bff;
            background-color: #f8f9fa;
        }
</style>

<div class="container-fluid p-0">
    <h2 class="h4 mb-4">
        <i class="bi bi-megaphone me-2 text-primary"></i>Announcement Management
    </h2>

    @* Hiển thị thông báo lỗi API (nếu có) *@
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage
        </div>
    }

    <div class="row">

        <div class="col-lg-5 mb-4">
            <div class="card p-4 shadow-lg border-0">
                <h5 class="fw-bold mb-4 text-primary">Compose New Announcement</h5>

                @using (Html.BeginForm("PostAnnouncement", "Lecturer", FormMethod.Post))
                {
                    @* Trường ẩn (Bắt buộc cho Database) *@
                    <input type="hidden" name="AuthorId" value="@currentLecturerId" />
                    <input type="hidden" name="IsGlobal" value="False" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Title</label>
                        <input type="text" class="form-control" name="Title"
                               placeholder="e.g., Mid-term Exam Schedule" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Body Content</label>
                        <textarea class="form-control rounded-bottom" name="Body" rows="5"
                              placeholder="Write your announcement details here..." required></textarea>
                    </div>

                    <hr class="my-4" />

                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-share me-2"></i>Target Class
                    </h6>

                    <div class="mb-4">
                        <label for="targetClassId" class="form-label">Select Class to Target</label>

                        <select class="form-select" id="targetClassId" name="TargetClassId" required>
                            <option value="" disabled selected>-- Select a Class --</option>

                            @if (ViewBag.TargetClassList != null)
                            {
                                @* Lặp qua danh sách SelectListItem đã chuẩn bị trong Controller *@
                                foreach (var item in (IEnumerable<SelectListItem>)ViewBag.TargetClassList)
                                {
                                    <option value="@item.Value">
                                        @item.Text
                                    </option>
                                }
                            }
                        </select>
                        <div class="form-text">
                            Students in this class will receive the notification.
                        </div>
                    </div> 
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-light me-2" onclick="window.location.reload();">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send-fill me-1"></i> Post Announcement
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <h5 class="fw-bold mb-3">Published & Scheduled Announcements</h5>

            <div class="input-group mb-4">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-start-0"
                       placeholder="Search announcements...">
            </div>

            <div class="list-group list-group-flush">
                @if (ViewBag.PostedAnnouncements != null)
                {
                    var announcements = (List<WebQuanLiKhoaHoc_MVC.Models.DTOs.AnnouncementDto>)ViewBag.PostedAnnouncements;

                    foreach (var ann in announcements)
                    {
                        <div class="list-group-item p-3 mb-3 border rounded shadow-sm">
                            <div class="d-flex justify-content-between">
                                <h6 class="fw-bold text-primary">@ann.Title</h6>
                                <small class="text-muted">@ann.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <p class="small text-dark mb-2">@ann.Body</p>
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="EditAnnouncement"
                                   asp-route-id="@ann.AnnouncementId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>


                                <form asp-action="DeleteAnnouncement"
                                      asp-controller="Lecturer"
                                      method="post"
                                      onsubmit="return confirm('Bạn có chắc muốn xoá thông báo này?');"
                                      class="d-inline">

                                    <input type="hidden" name="id" value="@ann.AnnouncementId" />

                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>

                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center text-muted">No announcements found.</p>
                }
            </div>
        </div>
    </div>
</div>