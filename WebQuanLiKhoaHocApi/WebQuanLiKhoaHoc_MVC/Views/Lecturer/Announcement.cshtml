@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewBag.Title = "Quản lý Thông báo";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";

    var apiBaseUrl = Configuration["ApiSettings:BaseUrl"];
}

<div class="container-fluid py-4">
    <div class="row">

        <!-- ================= CREATE ================= -->
        <div class="col-lg-5 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="bi bi-megaphone"></i> Tạo thông báo
                </div>
                <div class="card-body">
                    <form id="formAnnouncement">
                        <div class="mb-3">
                            <label class="form-label">Tiêu đề</label>
                            <input id="annTitle" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nội dung</label>
                            <textarea id="annBody" class="form-control" rows="5"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Lớp học</label>
                            <select id="annClassId" class="form-select"></select>
                        </div>

                        <button type="button" id="btnPost" class="btn btn-primary w-100">
                            Đăng thông báo
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ================= LIST ================= -->
        <div class="col-lg-7">
            <h5 class="fw-bold text-primary mb-3">
                Lịch sử thông báo
                <span class="badge bg-primary" id="annCount">0</span>
            </h5>

            <div id="announcement-list"></div>
        </div>
    </div>
</div>

<!-- ================= EDIT MODAL ================= -->
<div class="modal fade" id="editAnnModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Sửa thông báo</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="editAnnId" />

                <div class="mb-3">
                    <label>Tiêu đề</label>
                    <input id="editTitle" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Nội dung</label>
                    <textarea id="editBody" class="form-control" rows="5"></textarea>
                </div>

                <div class="mb-3">
                    <label>Lớp học</label>
                    <select id="editClassId" class="form-select"></select>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary" id="btnUpdateAnn">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {

            const lecturerId = 4;
            const apiBaseUrl = '@Html.Raw(apiBaseUrl)'.replace(/\/$/, '');

            /* ================= LOAD CLASSES ================= */
            function loadClasses(target, selectedId = null) {
                $.get(`${apiBaseUrl}/Classes/Lecturer/${lecturerId}`, function (data) {
                    let html = '<option value="">-- Chọn lớp --</option>';
                    data.forEach(c => {
                        html += `<option value="${c.classId}" ${c.classId === selectedId ? 'selected' : ''}>
                                    ${c.classCode} - ${c.courseName}
                                 </option>`;
                    });
                    $(target).html(html);
                });
            }

            /* ================= LOAD ANNOUNCEMENTS ================= */
            function loadAnnouncements() {
                $('#announcement-list').html('<div class="text-center">Đang tải...</div>');

                $.get(`${apiBaseUrl}/Announcements/Author/${lecturerId}`, function (data) {

                    $('#annCount').text(data.length);
                    if (!data.length) {
                        $('#announcement-list').html('<div class="text-muted">Chưa có thông báo</div>');
                        return;
                    }

                    let html = '';
                    data.forEach(a => {
                        html += `
                        <div class="card mb-3 shadow-sm border-start border-primary border-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <h6 class="fw-bold">${a.title}</h6>
                                    <div>
                                        <button class="btn btn-sm text-primary"
                                            onclick='openEditAnn(${JSON.stringify(a)})'>
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm text-danger"
                                            onclick="deleteAnn(${a.announcementId})">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <p class="text-muted small">${a.body}</p>
                                <small>${new Date(a.createdAt).toLocaleString("vi-VN")}</small>
                            </div>
                        </div>`;
                    });

                    $('#announcement-list').html(html);
                });
            }

            /* ================= CREATE ================= */
            $('#btnPost').click(function () {

                const data = {
                    authorId: lecturerId,
                    title: $('#annTitle').val(),
                    body: $('#annBody').val(),
                    targetClassId: parseInt($('#annClassId').val()),
                    isGlobal: false
                };

                if (!data.title || !data.body || !data.targetClassId) {
                    alert("Nhập đủ thông tin");
                    return;
                }

                $.ajax({
                    url: `${apiBaseUrl}/Announcements`,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: () => {
                        $('#formAnnouncement')[0].reset();
                        loadAnnouncements();
                    }
                });
            });

            /* ================= EDIT ================= */
            window.openEditAnn = function (a) {
                $('#editAnnId').val(a.announcementId);
                $('#editTitle').val(a.title);
                $('#editBody').val(a.body);
                loadClasses('#editClassId', a.targetClassId);
                new bootstrap.Modal('#editAnnModal').show();
            };

                    $('#btnUpdateAnn').click(function () {
            const id = $('#editAnnId').val();

            // Tạo object khớp hoàn toàn với Model Announcement ở Server
            const data = {
                announcementId: parseInt(id), // BẮT BUỘC có Id trong Body để khớp URL
                authorId: lecturerId,         // Nên gửi lại AuthorId để tránh null database
                title: $('#editTitle').val().trim(),
                body: $('#editBody').val().trim(),
                targetClassId: parseInt($('#editClassId').val()),
                isGlobal: false
            };

            if (!data.title || !data.body || !data.targetClassId) {
                alert("Vui lòng nhập đủ thông tin");
                return;
            }

            $.ajax({
                url: `${apiBaseUrl}/Announcements/${id}`,
                type: "PUT",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function() {
                    // Dùng API của Bootstrap để đóng modal an toàn
                    bootstrap.Modal.getInstance(document.getElementById('editAnnModal')).hide();
                    loadAnnouncements();
                    alert("Cập nhật thành công!");
                },
                error: function(xhr) {
                    console.error(xhr);
                    alert("Lỗi cập nhật. Hãy kiểm tra Console (F12)");
                }
            });
        });

            /* ================= DELETE ================= */
            window.deleteAnn = function (id) {
                if (!confirm("Xóa thông báo?")) return;

                $.ajax({
                    url: `${apiBaseUrl}/Announcements/${id}`,
                    type: "DELETE",
                    success: loadAnnouncements
                });
            };

            /* ================= INIT ================= */
            loadClasses('#annClassId');
            loadAnnouncements();
        });
    </script>
}