@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="fw-bold mb-4">Settings</h2>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-palette me-2 text-primary"></i>Appearance</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Dark Mode</h6>
                            <p class="text-muted small mb-0">Switch between light and dark themes for the entire dashboard.</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="darkModeToggle" style="width: 2.5em; height: 1.25em; cursor: pointer;">
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-info"></i>System Info</h5>
                    <div class="small text-muted">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Version</span>
                            <span class="fw-bold">1.0.2-stable</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Last Updated</span>
                            <span class="fw-bold">Dec 20, 2025</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            const toggle = $('#darkModeToggle');
            const body = $('body');

            // 1. Kiểm tra trạng thái đã lưu trong localStorage chưa
            if (localStorage.getItem('theme') === 'dark') {
                toggle.prop('checked', true);
            }

            // 2. Sự kiện khi gạt Toggle
            toggle.on('change', function () {
                if (this.checked) {
                    localStorage.setItem('theme', 'dark');
                    body.addClass('dark-mode');
                } else {
                    localStorage.setItem('theme', 'light');
                    body.removeClass('dark-mode');
                }
            });
        });
    </script>
}