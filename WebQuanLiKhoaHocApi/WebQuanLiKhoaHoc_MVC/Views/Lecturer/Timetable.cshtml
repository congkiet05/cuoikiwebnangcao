@{
    ViewBag.Title = "My Timetable";
    // Thiết lập Layout cho mô hình MPA
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";

    // @model YourNamespace.Models.TimetableViewModel
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0">My Timetable</h2>

        <div class="btn-group me-4" role="group">
            <input type="radio" class="btn-check" name="timeview" id="dayview" autocomplete="off">
            <label class="btn btn-outline-secondary btn-sm" for="dayview">Day</label>

            <input type="radio" class="btn-check" name="timeview" id="weekview" autocomplete="off" checked>
            <label class="btn btn-outline-secondary btn-sm" for="weekview">Week</label>

            <input type="radio" class="btn-check" name="timeview" id="monthview" autocomplete="off">
            <label class="btn btn-outline-secondary btn-sm" for="monthview">Month</label>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <button class="btn btn-sm btn-outline-secondary me-2"><i class="bi bi-chevron-left"></i></button>
            <button class="btn btn-sm btn-outline-secondary me-3"><i class="bi bi-chevron-right"></i></button>
            <h5 class="mb-0 fw-bold">October 21-27, 2024</h5>
        </div>
        <button class="btn btn-primary"><i class="bi bi-download me-1"></i> Export</button>
    </div>

    <div class="timetable-grid bg-white border rounded p-2 shadow-sm" style="overflow-x: auto;">

        <div class="d-flex">
            <div class="time-column text-muted small me-3 flex-shrink-0" style="width: 60px;">
                <div style="height: 30px;"></div> @* Header gap *@
                @for (int i = 9; i <= 15; i++)
                {
                    <div style="height: 60px; border-top: 1px dashed #eee; padding-top: 5px;">@i:00 AM</div>
                }
            </div>

            <div class="flex-grow-1 d-flex">
                @{
                    var days = new List<Tuple<string, string>> {
                                Tuple.Create("Mon", "21"),
                                Tuple.Create("Tue", "22"),
                                Tuple.Create("Wed", "23"),
                                Tuple.Create("Thu", "24"),
                                Tuple.Create("Fri", "25")
                                };
                }

                @foreach (var day in days)
                {
                    var isToday = day.Item2 == "23"; // Ví dụ Wed là hôm nay
                                                     <div class="day-column position-relative border-start" style="min-width: 120px; flex: 1;">
                                                         <div class="text-center p-2 mb-1 @(isToday ? "bg-primary text-white rounded-top" : "bg-light")">
                                                             <div class="small text-uppercase @(isToday ? "text-white" : "text-muted")">@day.Item1</div>
                                                             <div class="fw-bold @(isToday ? "text-white" : "text-dark")">@day.Item2</div>
                                                         </div>

                        @if (day.Item1 == "Mon")
                        {
                            <div class="timetable-event bg-info text-white rounded p-1 position-absolute" style="top: 30px; left: 5px; right: 5px; height: 30px;">
                                <div class="small fw-bold">CS101 Intro</div>
                                <div class="small">10:00 - 11:30 | Hall A</div>
                            </div>
                            <div class="timetable-event bg-purple text-white rounded p-1 position-absolute" style="top: 120px; left: 5px; right: 5px; height: 30px;">
                                <div class="small fw-bold">PhD Sync</div>
                                <div class="small">1:00 - 3:00</div>
                            </div>
                        }
                        @if (day.Item1 == "Tue")
                        {
                            <div class="timetable-event bg-success text-white rounded p-1 position-absolute" style="top: 70px; left: 5px; right: 5px; height: 30px;">
                                <div class="small fw-bold">Office Hours</div>
                                <div class="small">11:00 - 1:00 | Room 301</div>
                            </div>
                        }
                        @if (day.Item1 == "Wed")
                        {
                            <div class="timetable-event bg-info text-white rounded p-1 position-absolute" style="top: 30px; left: 5px; right: 5px; height: 30px;">
                                <div class="small fw-bold">CS101 Intro</div>
                                <div class="small">10:00 - 11:30 | Hall A</div>
                            </div>
                        }
                        @if (day.Item1 == "Thu")
                        {
                            <div class="timetable-event bg-success text-white rounded p-1 position-absolute" style="top: 120px; left: 5px; right: 5px; height: 30px;">
                                <div class="small fw-bold">Office Hours</div>
                                <div class="small">1:00 - 3:00 | Room 301</div>
                            </div>
                            <div class="timetable-event bg-orange text-white rounded p-1 position-absolute" style="top: 170px; left: 5px; right: 5px; height: 30px;">
                                <div class="small fw-bold">Faculty Mtg.</div>
                                <div class="small">3:00 - 4:00</div>
                            </div>
                        }
                        @if (day.Item1 == "Fri")
                        {
                            <div class="timetable-event bg-info text-white rounded p-1 position-absolute" style="top: -10px; left: 5px; right: 5px; height: 30px;">
                                <div class="small fw-bold">CS420 Adv. AI</div>
                                <div class="small">9:00 - 10:30 | Lab 5B</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <style>
        /* Custom CSS cho Timetable (Cần được đặt trong Site.css hoặc trong đây) */
        .time-column > div {
            min-height: 60px; /* Mỗi giờ là 60px */
            line-height: 1;
        }

        .day-column {
            min-height: 400px; /* Chiều cao tối thiểu của lưới */
        }

        .timetable-event {
            padding: 5px;
            font-size: 0.8rem;
            z-index: 10;
        }
        /* Màu custom */
        .bg-purple {
            background-color: #9370DB !important;
        }

        .bg-orange {
            background-color: #FF8C00 !important;
        }

        .bg-info {
            background-color: #6495ED !important;
        }

        .bg-success {
            background-color: #3CB371 !important;
        }
    </style>
}