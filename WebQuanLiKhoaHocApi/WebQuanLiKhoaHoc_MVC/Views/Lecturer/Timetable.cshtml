@{
    ViewBag.Title = "My Timetable";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";
}

<div class="container-fluid p-0">
    <div class="timetable-grid bg-white border rounded p-2 shadow-sm" style="overflow-x: auto;">
        <div class="d-flex" style="min-width: 1000px;">
            @* Đảm bảo đủ rộng cho 7 ngày *@

            <div class="time-column text-muted small me-2 flex-shrink-0" style="width: 60px; margin-top: 50px;">
                @for (int i = 7; i <= 17; i++)
                {
                    <div class="time-slot">@(i < 12 ? i + ":00 AM" : (i == 12 ? "12:00 PM" : (i - 12) + ":00 PM"))</div>
                }
            </div>

            <div class="flex-grow-1 d-flex">
                @{
                    var weekDays = new List<string> { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
                }

                @for (int i = 0; i < weekDays.Count; i++)
                {
                    var dayValue = i + 1;
                    <div class="day-column position-relative border-start" id="day-@dayValue" style="flex: 1;">
                        <div class="day-header text-center p-2 mb-1 bg-light border-bottom">
                            <div class="small text-uppercase text-muted">@weekDays[i]</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            const lecturerId = 2;
            const apiBaseUrl = "https://localhost:7274/api";
            const startHour = 7; // Mốc bắt đầu là 7h sáng
            const rowHeight = 60; // 1 giờ = 60px (1 phút = 1px)

            $.ajax({
                url: `${apiBaseUrl}/ClassSchedules/Lecturer/${lecturerId}`,
                type: "GET",
                success: function (data) {
                    $(".timetable-event").remove();

                    data.forEach(item => {
                        // 1. Phân tích Start Time
                        const start = item.startTime.split(':');
                        const hS = parseInt(start[0]);
                        const mS = parseInt(start[1]);

                        // 2. Phân tích End Time
                        const end = item.endTime.split(':');
                        const hE = parseInt(end[0]);
                        const mE = parseInt(end[1]);

                        // 3. Tính vị trí Top: (Giờ hiện tại - Giờ bắt đầu) * 60 + số phút + offset header (50px)
                        const topPos = ((hS - startHour) * rowHeight) + mS + 50;

                        // 4. Tính chiều cao thẻ: (Tổng phút kết thúc - Tổng phút bắt đầu)
                        const duration = (hE * 60 + mE) - (hS * 60 + mS);

                        // 5. Chọn màu sắc theo môn học (hoặc ngẫu nhiên)
                        const colors = ['bg-info', 'bg-success', 'bg-warning', 'bg-primary', 'bg-purple'];
                        const colorClass = colors[item.courseCode.length % colors.length];

                        const eventHtml = `
                            <div class="timetable-event ${colorClass} text-white rounded shadow-sm position-absolute"
                                 style="top: ${topPos}px; left: 4px; right: 4px; height: ${duration}px;">
                                <div class="p-1 overflow-hidden">
                                    <div class="fw-bold" style="font-size: 0.75rem;">${item.courseCode}</div>
                                    <div style="font-size: 0.65rem;">
                                        ${item.startTime}-${item.endTime}<br>
                                        <i class="bi bi-geo-alt"></i> ${item.room || 'N/A'}
                                    </div>
                                </div>
                            </div>`;

                        $(`#day-${item.dayOfWeek}`).append(eventHtml);
                    });
                }
            });
        });
    </script>

    <style>
        .time-slot {
            height: 60px;
            border-top: 1px dashed #eee;
            padding-top: 5px;
            line-height: 1;
        }

        .day-column {
            min-height: 660px; /* (17h - 7h) * 60px = 600px + header */
            background-image: linear-gradient(#f9f9f9 1px, transparent 1px);
            background-size: 100% 60px;
        }

        .day-header {
            height: 50px;
        }

        .timetable-event {
            z-index: 10;
            border-left: 3px solid rgba(0,0,0,0.1);
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }

            .timetable-event:hover {
                transform: scale(1.02);
                z-index: 50;
                box-shadow: 0 5px 15px rgba(0,0,0,0.3) !important;
            }

        .bg-purple {
            background-color: #6f42c1 !important;
        }
    </style>
}