@{
    ViewBag.Title = "Dashboard";
    // Thiết lập Layout cho mô hình MPA
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";

    // Giả định Model để hiển thị dữ liệu (Courses, Timetable...)
    // @model YourNamespace.Models.DashboardViewModel
}

<div class="card p-4 shadow-sm">

    <h2 class="h4 mb-1">Course Management & Timetable</h2>
    <p class="text-muted">View and manage your courses and weekly schedule.</p>

    <div class="row mt-4">

        <div class="col-lg-4 mb-4">
            <div class="card bg-light p-3 border-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Weekly Timetable</h5>
                    <div class="d-flex">
                        <span class="text-muted small me-2">October 21 - 25, 2024</span>
                        <button class="btn btn-sm btn-outline-secondary p-0 px-2 mx-1 rounded-circle"><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-sm btn-outline-secondary p-0 px-2 rounded-circle"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>

                <div class="row row-cols-5 g-1 text-center small">
                    <div class="col fw-bold text-uppercase">Mon</div>
                    <div class="col fw-bold text-uppercase">Tue</div>
                    <div class="col fw-bold text-uppercase">Wed</div>
                    <div class="col fw-bold text-uppercase">Thu</div>
                    <div class="col fw-bold text-uppercase">Fri</div>

                    @* Dữ liệu mẫu (Cần CSS tùy chỉnh cho màu sắc bg-info, bg-warning, bg-success) *@
                    <div class="col p-1">
                        <div class="p-2 rounded bg-info text-white">
                            CS202<br />Lab<br />13:00-15:00<br />Lab 2B
                        </div>
                    </div>
                    <div class="col p-1"></div>
                    <div class="col p-1">
                        <div class="p-2 rounded bg-warning text-dark">
                            CS451<br />Lec<br />10:00-12:00<br />Hall A
                        </div>
                    </div>
                    <div class="col p-1"></div>
                    <div class="col p-1">
                        <div class="p-2 rounded bg-success text-white">
                            CS101<br />Lab<br />14:00-16:00<br />Lab 1A
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">My Courses (@* @Model.Courses.Count *@)</h5>
                <a href="@Url.Action("CreateCourse", "Lecturer")" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add New Course
                </a>
            </div>

            <div class="input-group mb-4">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control border-start-0" placeholder="Search by course name or code...">
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Course Title & Code</th>
                            <th>Students</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* @foreach (var course in Model.Courses) *@
                        <tr>
                            <td>
                                <strong>Introduction to Programming - CS101</strong>
                            </td>
                            <td>124</td>
                            <td><span class="badge bg-success py-2 px-3">Active</span></td>
                            <td><a href="@Url.Action("Details", "Lecturer", new { id = "CS101" })" class="btn btn-link p-0 text-primary">View Details</a></td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Advanced Database Systems - CS451</strong>
                            </td>
                            <td>45</td>
                            <td><span class="badge bg-secondary py-2 px-3">Archived</span></td>
                            <td><a href="@Url.Action("Details", "Lecturer", new { id = "CS451" })" class="btn btn-link p-0 text-primary">View Details</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>