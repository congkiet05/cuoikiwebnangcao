@{
    ViewBag.Title = "Dashboard";
    // Thiết lập Layout cho mô hình MPA
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";

    // Giả định Model để hiển thị dữ liệu (Courses, Timetable...)
    // @model YourNamespace.Models.DashboardViewModel
}

@* Định nghĩa màu sắc tùy chỉnh cho Timetable (Nên đưa vào file CSS) *@
<style>
    /* Custom Color Palette cho lịch trình */
    :root {
        --course-color-1: #007bff; /* Primary/Info */
        --course-color-2: #ffc107; /* Warning */
        --course-color-3: #28a745; /* Success */
        --course-color-4: #dc3545; /* Danger */
    }

    .timetable-entry-1 {
        background-color: var(--course-color-1);
        color: white;
    }

    .timetable-entry-2 {
        background-color: var(--course-color-2);
        color: #343a40;
    }
    /* Dark text for light background */
    .timetable-entry-3 {
        background-color: var(--course-color-3);
        color: white;
    }

    .timetable-day-cell {
        min-height: 80px; /* Chiều cao tối thiểu cho ô ngày */
    }
</style>

<div class="container-fluid">

    <h1 class="mb-4 display-6 fw-bold">Xin chào Giảng viên!</h1>

    <div class="row mb-5">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm p-3 bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title fw-normal">Tổng Khóa Học Đang Hoạt Động</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="display-4 mb-0 fw-bold">3</h2> @* @Model.ActiveCoursesCount *@
                        <i class="bi bi-book-half fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm p-3 bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title fw-normal">Tổng Số Sinh Viên</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="display-4 mb-0 fw-bold">169</h2> @* @Model.TotalStudentsCount *@
                        <i class="bi bi-people-fill fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm p-3 bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title fw-normal">Lịch Trình Tuần Này</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="display-4 mb-0 fw-bold">3/5</h2> @* @Model.TotalClassesThisWeek *@
                        <i class="bi bi-calendar-check fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-lg-12 col-xl-5 mb-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0 text-primary"><i class="bi bi-calendar-event me-2"></i>Lịch Giảng Dạy Tuần</h4>
                        <div class="btn-group" role="group" aria-label="Timetable navigation">
                            <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-left"></i></button>
                            <span class="btn btn-light btn-sm disabled">21 - 25, 2024</span>
                            <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                    <p class="text-muted small mt-1">Chi tiết cho tuần **21 - 25/10/2024**</p>
                </div>

                <div class="card-body pt-2">
                    <div class="row row-cols-5 g-1 text-center small fw-bold mb-2">
                        <div class="col text-uppercase">T2</div>
                        <div class="col text-uppercase">T3</div>
                        <div class="col text-uppercase">T4</div>
                        <div class="col text-uppercase">T5</div>
                        <div class="col text-uppercase">T6</div>
                    </div>

                    <div class="row row-cols-5 g-2 text-center">
                        <div class="col p-1 timetable-day-cell">
                            <div class="p-2 rounded shadow-sm timetable-entry-1" data-bs-toggle="tooltip" title="CS202 Lab (13:00 - 15:00) tại Lab 2B">
                                <small>
                                    <strong class="text-uppercase">CS202</strong><br />
                                    Lab<br />
                                    13:00-15:00
                                </small>
                            </div>
                        </div>
                        <div class="col p-1 timetable-day-cell"></div>
                        <div class="col p-1 timetable-day-cell">
                            <div class="p-2 rounded shadow-sm timetable-entry-2" data-bs-toggle="tooltip" title="CS451 Lecture (10:00 - 12:00) tại Hall A">
                                <small>
                                    <strong class="text-uppercase">CS451</strong><br />
                                    Lec<br />
                                    10:00-12:00
                                </small>
                            </div>
                        </div>
                        <div class="col p-1 timetable-day-cell"></div>
                        <div class="col p-1 timetable-day-cell">
                            <div class="p-2 rounded shadow-sm timetable-entry-3" data-bs-toggle="tooltip" title="CS101 Lab (14:00 - 16:00) tại Lab 1A">
                                <small>
                                    <strong class="text-uppercase">CS101</strong><br />
                                    Lab<br />
                                    14:00-16:00
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center">
                    <a href="#" class="btn btn-outline-primary btn-sm">Xem lịch chi tiết <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-lg-12 col-xl-7 mb-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0 text-dark"><i class="bi bi-collection me-2"></i>Các Khóa Học Của Tôi</h4>
                        <a href="@Url.Action("CreateCourse", "Lecturer")" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Thêm Khóa Học Mới
                        </a>
                    </div>
                    <p class="text-muted small mt-1">Tổng cộng **2** khóa học đang quản lý.</p> @* @Model.Courses.Count *@
                </div>
                <div class="card-body pt-2">

                    <div class="input-group mb-4">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm kiếm theo tên khóa học hoặc mã...">
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã & Tên Khóa Học</th>
                                    <th>SV Tham Gia</th>
                                    <th>Trạng Thái</th>
                                    <th>Hành Động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* @foreach (var course in Model.Courses) *@
                                <tr>
                                    <td>
                                        <strong class="d-block">Introduction to Programming</strong>
                                        <small class="text-muted">CS101</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark fw-bold">124</span>
                                    </td>
                                    <td><span class="badge bg-success py-2 px-3">Đang Hoạt Động</span></td>
                                    <td>
                                        <a href="@Url.Action("Details", "Lecturer", new { id = "CS101" })" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>Chỉnh sửa</a></li>
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-archive me-2"></i>Lưu trữ</a></li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong class="d-block">Advanced Database Systems</strong>
                                        <small class="text-muted">CS451</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark fw-bold">45</span>
                                    </td>
                                    <td><span class="badge bg-secondary py-2 px-3">Đã Lưu Trữ</span></td>
                                    <td>
                                        <a href="@Url.Action("Details", "Lecturer", new { id = "CS451" })" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>Chỉnh sửa</a></li>
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-box-arrow-in-up me-2"></i>Kích hoạt lại</a></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-end">
                    <a href="#" class="text-primary">Xem tất cả khóa học <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>