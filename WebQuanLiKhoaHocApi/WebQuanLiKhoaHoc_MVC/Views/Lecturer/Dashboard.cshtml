@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";
}

@* Định nghĩa màu sắc tùy chỉnh cho Timetable (Nên đưa vào file CSS) *@
<style>
    /* Custom Color Palette cho lịch trình */
    :root {
        --course-color-1: #007bff; /* Primary/Info */
        --course-color-2: #ffc107; /* Warning */
        --course-color-3: #28a745; /* Success */
        --course-color-4: #dc3545; /* Danger */
    }

    .timetable-entry-1 {
        background-color: var(--course-color-1);
        color: white;
    }

    .timetable-entry-2 {
        background-color: var(--course-color-2);
        color: #343a40;
    }
    /* Dark text for light background */
    .timetable-entry-3 {
        background-color: var(--course-color-3);
        color: white;
    }

    .timetable-day-cell {
        min-height: 80px; /* Chiều cao tối thiểu cho ô ngày */
    }
</style>

<div class="container-fluid">

    <h1 class="mb-4 display-6 fw-bold">Xin chào Giảng viên!</h1>

    <div class="row mb-5">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm p-3 bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title fw-normal">Tổng Khóa Học Đang Hoạt Động</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="display-4 mb-0 fw-bold">3</h2> @* @Model.ActiveCoursesCount *@
                        <i class="bi bi-book-half fs-1 opacity-75"></i>
<div class="container-fluid p-0">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1" id="today-date">Loading date...</p>
                        <h2 class="fw-bold mb-0">Good morning, <span id="welcome-name">Lecturer</span>.</h2>
                        <p class="text-muted mb-0">Here is your daily summary.</p>
                    </div>
                    <div class="d-none d-md-flex align-items-center border rounded-pill px-3 py-2 bg-light">
                        <img src="~/images/avatar.jpg" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
                        <div>
                            <div class="fw-bold small" id="badge-name">Loading...</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Lecturer</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm p-3 bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title fw-normal">Tổng Số Sinh Viên</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="display-4 mb-0 fw-bold">169</h2> @* @Model.TotalStudentsCount *@
                        <i class="bi bi-people-fill fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm p-3 bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title fw-normal">Lịch Trình Tuần Này</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="display-4 mb-0 fw-bold">3/5</h2> @* @Model.TotalClassesThisWeek *@
                        <i class="bi bi-calendar-check fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-lg-12 col-xl-5 mb-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0 text-primary"><i class="bi bi-calendar-event me-2"></i>Lịch Giảng Dạy Tuần</h4>
                        <div class="btn-group" role="group" aria-label="Timetable navigation">
                            <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-left"></i></button>
                            <span class="btn btn-light btn-sm disabled">21 - 25, 2024</span>
                            <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                    <p class="text-muted small mt-1">Chi tiết cho tuần **21 - 25/10/2024**</p>
                </div>

                <div class="card-body pt-2">
                    <div class="row row-cols-5 g-1 text-center small fw-bold mb-2">
                        <div class="col text-uppercase">T2</div>
                        <div class="col text-uppercase">T3</div>
                        <div class="col text-uppercase">T4</div>
                        <div class="col text-uppercase">T5</div>
                        <div class="col text-uppercase">T6</div>
                    </div>

                    <div class="row row-cols-5 g-2 text-center">
                        <div class="col p-1 timetable-day-cell">
                            <div class="p-2 rounded shadow-sm timetable-entry-1" data-bs-toggle="tooltip" title="CS202 Lab (13:00 - 15:00) tại Lab 2B">
                                <small>
                                    <strong class="text-uppercase">CS202</strong><br />
                                    Lab<br />
                                    13:00-15:00
                                </small>
                            </div>
                        </div>
                        <div class="col p-1 timetable-day-cell"></div>
                        <div class="col p-1 timetable-day-cell">
                            <div class="p-2 rounded shadow-sm timetable-entry-2" data-bs-toggle="tooltip" title="CS451 Lecture (10:00 - 12:00) tại Hall A">
                                <small>
                                    <strong class="text-uppercase">CS451</strong><br />
                                    Lec<br />
                                    10:00-12:00
                                </small>
                            </div>
                        </div>
                        <div class="col p-1 timetable-day-cell"></div>
                        <div class="col p-1 timetable-day-cell">
                            <div class="p-2 rounded shadow-sm timetable-entry-3" data-bs-toggle="tooltip" title="CS101 Lab (14:00 - 16:00) tại Lab 1A">
                                <small>
                                    <strong class="text-uppercase">CS101</strong><br />
                                    Lab<br />
                                    14:00-16:00
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center">
                    <a href="#" class="btn btn-outline-primary btn-sm">Xem lịch chi tiết <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>

        <div class="col-lg-12 col-xl-7 mb-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0 text-dark"><i class="bi bi-collection me-2"></i>Các Khóa Học Của Tôi</h4>
                        <a href="@Url.Action("CreateCourse", "Lecturer")" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Thêm Khóa Học Mới
                        </a>
                    </div>
                    <p class="text-muted small mt-1">Tổng cộng **2** khóa học đang quản lý.</p> @* @Model.Courses.Count *@
                </div>
                <div class="card-body pt-2">

                    <div class="input-group mb-4">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm kiếm theo tên khóa học hoặc mã...">
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã & Tên Khóa Học</th>
                                    <th>SV Tham Gia</th>
                                    <th>Trạng Thái</th>
                                    <th>Hành Động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* @foreach (var course in Model.Courses) *@
                                <tr>
                                    <td>
                                        <strong class="d-block">Introduction to Programming</strong>
                                        <small class="text-muted">CS101</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark fw-bold">124</span>
                                    </td>
                                    <td><span class="badge bg-success py-2 px-3">Đang Hoạt Động</span></td>
                                    <td>
                                        <a href="@Url.Action("Details", "Lecturer", new { id = "CS101" })" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>Chỉnh sửa</a></li>
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-archive me-2"></i>Lưu trữ</a></li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong class="d-block">Advanced Database Systems</strong>
                                        <small class="text-muted">CS451</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark fw-bold">45</span>
                                    </td>
                                    <td><span class="badge bg-secondary py-2 px-3">Đã Lưu Trữ</span></td>
                                    <td>
                                        <a href="@Url.Action("Details", "Lecturer", new { id = "CS451" })" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>Chỉnh sửa</a></li>
                                            <li><a class="dropdown-item" href="#"><i class="bi bi-box-arrow-in-up me-2"></i>Kích hoạt lại</a></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-end">
                    <a href="#" class="text-primary">Xem tất cả khóa học <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold"><i class="bi bi-calendar3 text-primary me-2"></i>Today's Schedule</h5>
                </div>
                <div id="schedule-list" class="card-body px-4">
                    <div class="text-center p-5 text-muted">
                        <div class="spinner-border spinner-border-sm me-2"></div> Fetching your schedule...
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0"><i class="bi bi-bell text-warning me-2"></i>Notifications</h5>
                        <a href="@Url.Action("Notification", "Lecturer")" class="small text-decoration-none">View all <i class="bi bi-arrow-right"></i></a>
                    </div>

                    <div class="mb-4 p-4 bg-light rounded text-center">
                        <h2 class="mb-0 fw-bold text-primary" id="unread-count">0</h2>
                        <p class="text-muted small mb-0">Unread Notifications</p>
                    </div>

                    <div id="latest-notifications">
                        <p class="text-muted small text-center">Checking for new alerts...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            const lecturerId = 2;
            const apiBaseUrl = "https://localhost:7274/api";

            // --- 1. LẤY THÔNG TIN GIẢNG VIÊN ---
            $.ajax({
                url: `${apiBaseUrl}/Lecturers/${lecturerId}`,
                type: "GET",
                success: function (data) {
                    if (data) {
                        const nameParts = data.fullName.trim().split(' ');
                        const firstName = nameParts[nameParts.length - 1];
                        $('#welcome-name').text(firstName);
                        $('#badge-name').text(data.fullName);
                    }
                }
            });

            // --- 2. CẬP NHẬT NGÀY THÁNG ---
            const options = { weekday: 'long', month: 'short', day: 'numeric' };
            const today = new Date().toLocaleDateString('en-US', options);
            $('#today-date').text('Today is ' + today);

            // --- 3. LẤY SỐ LƯỢNG THÔNG BÁO CHƯA ĐỌC (DỮ LIỆU THẬT) ---
            $.ajax({
                url: `${apiBaseUrl}/Notifications/Lecturer/${lecturerId}`,
                type: "GET",
                success: function (data) {
                    // Lọc những thông báo có IsRead === false
                    const unreadItems = data.filter(n => n.isRead === false);
                    $('#unread-count').text(unreadItems.length);

                    // Hiển thị nhanh 1-2 tiêu đề thông báo mới nhất bên dưới con số
                    if (unreadItems.length > 0) {
                        let notifyHtml = '<div class="small border-top pt-3">';
                        unreadItems.slice(0, 2).forEach(item => {
                            notifyHtml += `
                                <div class="mb-2">
                                    <span class="fw-bold text-dark d-block text-truncate">${item.title}</span>
                                    <span class="text-muted" style="font-size:0.75rem;">${new Date(item.createdAt).toLocaleDateString()}</span>
                                </div>`;
                        });
                        notifyHtml += '</div>';
                        $('#latest-notifications').html(notifyHtml);
                    } else {
                        $('#latest-notifications').html('<p class="text-muted small text-center mt-3">You are all caught up!</p>');
                    }
                },
                error: function() {
                    $('#unread-count').text("!");
                }
            });

            // --- 4. LẤY LỊCH TRÌNH HÔM NAY ---
            $.ajax({
                url: `${apiBaseUrl}/ClassSchedules/Lecturer/${lecturerId}/Today`,
                type: "GET",
                success: function (data) {
                    let html = '';
                    if (!data || data.length === 0) {
                        html = `
                            <div class="text-center p-5">
                                <i class="bi bi-calendar-check text-muted" style="font-size: 3rem;"></i>
                                <p class="mt-3 text-muted">No classes scheduled for today.</p>
                            </div>`;
                    } else {
                        data.forEach(item => {
                            const hour = parseInt(item.startTime.split(':')[0]);
                            const period = hour < 12 ? 'AM' : 'PM';

                            html += `
                            <div class="d-flex align-items-center p-3 mb-3 border rounded shadow-sm hover-shadow transition">
                                <div class="text-center border-end pe-3 me-3" style="min-width: 80px;">
                                    <div class="fw-bold text-primary">${item.startTime}</div>
                                    <div class="small text-muted">${period}</div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 fw-bold">${item.courseName}</h6>
                                    <div class="small text-muted">
                                        <i class="bi bi-geo-alt me-1"></i> ${item.room || 'N/A'} |
                                        <i class="bi bi-book me-1"></i> ${item.courseCode}
                                    </div>
                                </div>
                            </div>`;
                        });
                    }
                    $('#schedule-list').html(html);
                },
                error: function() {
                    $('#schedule-list').html('<div class="text-danger p-3 text-center">Unable to load schedule.</div>');
                }
            });
        });
    </script>

    <style>
        .hover-shadow:hover {
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            border-color: #0d6efd !important;
            cursor: pointer;
        }

        .transition {
            transition: all 0.3s ease;
        }
    </style>
}