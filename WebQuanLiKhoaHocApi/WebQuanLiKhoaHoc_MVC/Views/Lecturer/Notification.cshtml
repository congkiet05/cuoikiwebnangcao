@{
    ViewBag.Title = "Notification Center";
    // Thiết lập Layout cho mô hình MPA
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";

    // Giả định: Dữ liệu thông báo
    // Cần thêm CSS cho .list-group-item-unread
}

<style>
    /* Custom style cho thông báo chưa đọc */
    .list-group-item-unread {
        background-color: #f8f9fa; /* Light Gray background */
        border-left: 5px solid #007bff !important; /* Blue border cho Unread */
    }

        .list-group-item-unread .notification-dot {
            width: 8px;
            height: 8px;
            background-color: #dc3545; /* Red dot */
            border-radius: 50%;
            margin-top: 5px;
            margin-right: 10px;
            flex-shrink: 0;
        }
</style>

<div class="container-fluid p-0">
    <div class="row">

        <div class="col-lg-8 mb-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 mb-0 fw-bold text-primary"><i class="bi bi-bell-fill me-2"></i>Notification Center</h2>
                <div class="d-flex">
                    <button class="btn btn-sm btn-outline-secondary me-2">Settings</button>
                    <button class="btn btn-sm btn-primary">Mark All as Read</button>
                </div>
            </div>

            <div class="mb-4">
                <label for="quickCourseFilter" class="form-label fw-bold small text-muted">QUICK FILTER BY COURSE</label>
                <select class="form-select" id="quickCourseFilter">
                    <option selected>All Courses</option>
                    <option>CS101 Intro to Programming</option>
                    <option>DS250 Data Science</option>
                    <option>ART101 The Renaissance</option>
                </select>
            </div>

            <div class="list-group list-group-flush border rounded shadow-sm">

                @* 1. Thông báo khẩn cấp (URGENCY - UNREAD) *@
                <a href="#" class="list-group-item list-group-item-action d-flex align-items-start p-3 list-group-item-unread">
                    <div class="notification-dot"></div> @* Dấu chấm đỏ cho UNREAD *@
                    <div class="me-3 border-start border-danger border-4 ps-3 py-1 flex-grow-1">
                        <h6 class="mb-1 fw-bold text-danger"><i class="bi bi-exclamation-circle-fill me-2"></i> Grading for Assignment 2 is due in 48 hours</h6>
                        <small class="text-muted d-block">System Alert</small>
                        <small class="text-muted small">Yesterday</small>
                    </div>
                </a>

                @* 2. Thông báo bài nộp mới (SUBMISSION - UNREAD) *@
                <a href="#" class="list-group-item list-group-item-action d-flex align-items-start p-3 list-group-item-unread">
                    <div class="notification-dot"></div> @* Dấu chấm đỏ cho UNREAD *@
                    <div class="me-3 border-start border-warning border-4 ps-3 py-1 flex-grow-1">
                        <h6 class="mb-1 fw-bold text-warning"><i class="bi bi-file-earmark-text-fill me-2"></i> New Assignment 3 Submission from John Doe</h6>
                        <small class="text-muted d-block">Course: CS101 Intro to Programming</small>
                        <small class="text-muted small">5 min ago</small>
                    </div>
                </a>

                @* 3. Tin nhắn sinh viên (MESSAGE - UNREAD) *@
                <a href="@Url.Action("Message", "Lecturer")" class="list-group-item list-group-item-action d-flex align-items-start p-3 list-group-item-unread">
                    <div class="notification-dot"></div> @* Dấu chấm đỏ cho UNREAD *@
                    <div class="me-3 border-start border-primary border-4 ps-3 py-1 flex-grow-1">
                        <h6 class="mb-1 fw-bold text-primary"><i class="bi bi-chat-text-fill me-2"></i> Question about upcoming exam</h6>
                        <small class="text-muted d-block">From: Jane Smith • Course: DS250</small>
                        <small class="text-muted small">1 hour ago</small>
                    </div>
                </a>

                @* 4. Thông báo hệ thống (READ) *@
                <a href="#" class="list-group-item list-group-item-action d-flex align-items-start p-3">
                    <div class="me-3 border-start border-success border-4 ps-3 py-1 flex-grow-1">
                        <h6 class="mb-1 text-success"><i class="bi bi-check-circle-fill me-2"></i> All grades for Assignment 1 have been published</h6>
                        <small class="text-muted d-block">System Announcement</small>
                        <small class="text-muted small">2 days ago</small>
                    </div>
                </a>

            </div>
        </div>

        <div class="col-lg-4">
            <div class="card p-4 shadow-sm border-0 sticky-top" style="top: 20px;">

                <h5 class="fw-bold mb-4 text-secondary"><i class="bi bi-sliders me-2"></i>Filter Options</h5>

                <div class="input-group mb-4">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Search notifications...">
                </div>

                <h6 class="fw-bold mb-2 small text-muted">STATUS</h6>
                <div class="btn-group w-100 mb-4" role="group">
                    <input type="radio" class="btn-check" name="filterStatus" id="statusAll" checked>
                    <label class="btn btn-outline-secondary btn-sm" for="statusAll">All</label>

                    <input type="radio" class="btn-check" name="filterStatus" id="statusUnread">
                    <label class="btn btn-outline-danger btn-sm" for="statusUnread">Unread</label>

                    <input type="radio" class="btn-check" name="filterStatus" id="statusRead">
                    <label class="btn btn-outline-success btn-sm" for="statusRead">Read</label>
                </div>


                <h6 class="fw-bold mb-2 small text-muted">TYPE</h6>
                <div class="mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="filterType" id="typeSubmission" checked>
                        <label class="form-check-label" for="typeSubmission"><i class="bi bi-file-earmark-text me-1"></i> New Submission</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="filterType" id="typeMessage" checked>
                        <label class="form-check-label" for="typeMessage"><i class="bi bi-chat-text me-1"></i> Student Message</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="filterType" id="typeAlert" checked>
                        <label class="form-check-label" for="typeAlert"><i class="bi bi-bell me-1"></i> System Alert</label>
                    </div>
                </div>

                <h6 class="fw-bold mb-2 small text-muted">URGENCY</h6>
                <select class="form-select form-select-sm mb-4">
                    <option selected>All Urgency Levels</option>
                    <option>High (Deadlines)</option>
                    <option>Medium (Reminders)</option>
                    <option>Low (Informational)</option>
                </select>

                <div class="d-grid mb-2">
                    <button class="btn btn-primary"><i class="bi bi-filter-circle me-1"></i> Apply Filters</button>
                </div>
                <div class="d-grid">
                    <button class="btn btn-outline-secondary">Reset Filters</button>
                </div>

            </div>
        </div>
    </div>
</div>