@{
    ViewBag.Title = "Notification Center";
    Layout = "~/Views/Shared/_LayoutLecturer.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <h2 class="h4 mb-1 fw-bold">Admin Announcements</h2>
                            <p class="text-muted small mb-0">Stay updated with the latest news from university administration.</p>
                        </div>
                        <button id="mark-all-read" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-check2-all me-1"></i> Mark All as Read
                        </button>
                    </div>

                    <div class="mt-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="search-notification" class="form-control border-start-0 ps-0"
                                   placeholder="Search announcements by title or content...">
                        </div>
                    </div>
                </div>
            </div>

            <div id="notification-container" class="list-group shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="text-center p-5 bg-white">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Fetching announcements...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            const lecturerId = 2; // Giả lập ID giảng viên
            const apiBaseUrl = "https://localhost:7274/api";

            // 1. Hàm load danh sách thông báo từ Admin
            function loadNotifications(searchQuery = "") {
                // JOIN Notification với Announcement để lấy thông tin admin post
                $.ajax({
                    url: `${apiBaseUrl}/Notifications/Lecturer/${lecturerId}`,
                    type: "GET",
                    success: function (data) {
                        let html = '';
                        // Lọc dữ liệu theo từ khóa tìm kiếm (Client-side search)
                        const filteredData = data.filter(n =>
                            n.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
                            n.body.toLowerCase().includes(searchQuery.toLowerCase())
                        );

                        if (filteredData.length === 0) {
                            html = '<div class="list-group-item text-center py-5 bg-white text-muted">No announcements found.</div>';
                        } else {
                            filteredData.forEach(item => {
                                const unreadClass = item.isRead ? "" : "bg-light border-start border-primary border-4";
                                const badgeRead = item.isRead ? "" : '<span class="badge bg-primary rounded-pill ms-2">New</span>';

                                html += `
                                    <div class="list-group-item list-group-item-action p-3 ${unreadClass} notification-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center mb-1">
                                                    <h6 class="fw-bold mb-0">${item.title}</h6>
                                                    ${badgeRead}
                                                </div>
                                                <p class="text-muted small mb-2">${item.body}</p>
                                                <div class="d-flex align-items-center text-muted" style="font-size: 0.75rem;">
                                                    <i class="bi bi-person-badge me-1"></i> Admin •
                                                    <i class="bi bi-clock ms-2 me-1"></i> ${new Date(item.createdAt).toLocaleDateString()}
                                                </div>
                                            </div>
                                            <div class="ms-3">
                                                <button class="btn btn-link text-decoration-none p-0 mark-single-read" data-id="${item.notificationId}">
                                                    <i class="bi bi-circle${item.isRead ? '-fill text-muted' : ' text-primary'}"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>`;
                            });
                        }
                        $('#notification-container').html(html);
                    },
                    error: function () {
                        $('#notification-container').html('<div class="list-group-item text-danger text-center py-4">Error loading notifications.</div>');
                    }
                });
            }

            // Gọi lần đầu
            loadNotifications();

            // 2. Xử lý tìm kiếm (Real-time search)
            $('#search-notification').on('keyup', function () {
                const query = $(this).val();
                loadNotifications(query);
            });

            // 3. Xử lý đánh dấu tất cả là đã đọc
            $('#mark-all-read').on('click', function () {
                $.ajax({
                    url: `${apiBaseUrl}/Notifications/Lecturer/${lecturerId}/MarkAllRead`,
                    type: "PUT",
                    success: function () {
                        loadNotifications(); // Reload lại danh sách
                    }
                });
            });

            // 4. Xử lý đánh dấu từng cái (Optional)
            $(document).on('click', '.mark-single-read', function(e) {
                e.preventDefault();
                const id = $(this).data('id');
                $.ajax({
                    url: `${apiBaseUrl}/Notifications/${id}/MarkAsRead`,
                    type: "PUT",
                    success: function() { loadNotifications(); }
                });
            });
        });
    </script>

    <style>
        .notification-item {
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .notification-item:hover {
                transform: translateX(5px);
                background-color: #f8f9fa;
            }

        .border-4 {
            border-left-width: 4px !important;
        }
    </style>
}