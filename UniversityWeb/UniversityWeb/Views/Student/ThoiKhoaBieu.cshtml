@model dynamic

<h2>Thời khóa biểu</h2>

<table class="table table-bordered">
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.CourseName</td>
            <td>Thứ @t.DayOfWeek</td>
            <td>@t.StartTime - @t.EndTime</td>
            <td>@t.Room</td>
        </tr>
    }
</table>
