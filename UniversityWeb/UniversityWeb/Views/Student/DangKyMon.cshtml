@model IEnumerable<UniversityWeb.Models.Class>

@{
    ViewBag.Title = "Đăng ký môn học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h3 class="text-primary mb-3">📘 Danh sách lớp học</h3>

    <table class="table table-bordered table-hover shadow">
        <thead class="table-dark">
            <tr>
                <th>Môn học</th>
                <th>Giảng viên</th>
                <th>Số lượng</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Course.CourseName</td>
                    <td>@item.Lecturer.LecturerName</td>
                    <td>@item.MaxStudent</td>
                    <td>
                        <a href="/Student/DangKy/@item.ClassId"
                           class="btn btn-sm btn-success">
                            Đăng ký
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
